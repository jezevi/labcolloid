  <section class="mod" id="mod-zeta" role="tabpanel" hidden>
    <div class="mod-head">
      <h2>Электрокинетический ζ-потенциал</h2>
      <p>Макроэлектрофорез и электроосмос, уравнение Гельмгольца — Смолуховского, поправки Хюккеля и Генри.</p>
    </div>
    <div class="grid2">
      <div class="col">
        <article class="card">
          <h3>Метод и данные</h3>
          <div class="demo-row">
            <select id="zeta-demo" aria-label="Пример данных"></select>
            <button class="btn primary" id="zeta-load" type="button">Загрузить пример данных</button>
          </div>
          <p class="hint" id="zeta-demo-note"></p>
          <div class="fld"><span class="lb">Метод</span>
            <div class="seg" id="zeta-method" role="radiogroup" aria-label="Метод"><button type="button" role="radio" data-v="ep">Электрофорез</button><button type="button" role="radio" data-v="eo">Электроосмос</button></div></div>

          <div id="zeta-ep">
            <div class="fld"><span class="lb">Что известно</span>
              <div class="seg" id="zeta-epin" role="radiogroup" aria-label="Входные данные"><button type="button" role="radio" data-v="shift">Смещение границы</button><button type="button" role="radio" data-v="velocity">Скорость и поле</button></div></div>
            <div class="fields" id="zeta-ep-shift">
              <label class="fld"><span class="lb">Смещение границы a, мм</span><input id="zeta-a" inputmode="decimal" autocomplete="off"></label>
              <label class="fld"><span class="lb">Время τ, мин</span><input id="zeta-tau" inputmode="decimal" autocomplete="off"></label>
              <label class="fld"><span class="lb">Напряжение U, В</span><input id="zeta-U" inputmode="decimal" autocomplete="off"></label>
              <label class="fld"><span class="lb">Расстояние между электродами L, м</span><input id="zeta-L" inputmode="decimal" autocomplete="off"></label>
            </div>
            <div class="fields" id="zeta-ep-vel" hidden>
              <label class="fld"><span class="lb">Линейная скорость u, мкм/с</span><input id="zeta-u" inputmode="decimal" autocomplete="off"></label>
              <label class="fld"><span class="lb">Напряжённость поля E, В/м</span><input id="zeta-E" inputmode="decimal" autocomplete="off"></label>
