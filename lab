            <select id="zeta-dir"><option value="cathode">к катоду (частицы заряжены +)</option><option value="anode">к аноду (частицы заряжены −)</option></select></label>
        </article>

        <article class="card">
          <h3>Среда и поправки</h3>
          <div class="fields">
            <label class="fld"><span class="lb">ε среды (вода 20 °C ≈ 80,1)</span><input id="zeta-eps" inputmode="decimal" autocomplete="off"></label>
            <label class="fld"><span class="lb">ε₀, Ф/м</span><input id="zeta-eps0" value="8,854·10⁻¹²" readonly aria-readonly="true"></label>
            <label class="fld"><span class="lb">η, Па·с (вода 20 °C ≈ 0,001)</span><input id="zeta-eta" inputmode="decimal" autocomplete="off"></label>
