            <div id="zeta-eo-flux">
              <div class="fld"><span class="lb">Скорость переноса жидкости</span>
                <div class="seg" id="zeta-vmode" role="radiogroup" aria-label="Задание скорости"><button type="button" role="radio" data-v="volume">объём за время</button><button type="button" role="radio" data-v="rate">объёмная скорость</button></div></div>
              <div class="fields">
                <label class="fld" data-vm="volume"><span class="lb">Объём V, мл</span><input id="zeta-V" inputmode="decimal" autocomplete="off"></label>
                <label class="fld" data-vm="volume"><span class="lb">Время τ, с</span><input id="zeta-eotau" inputmode="decimal" autocomplete="off"></label>
                <label class="fld" data-vm="rate" hidden><span class="lb">Объёмная скорость v, мл/с</span><input id="zeta-v" inputmode="decimal" autocomplete="off"></label>
                <label class="fld"><span class="lb">Сила тока I, мА</span><input id="zeta-I" inputmode="decimal" autocomplete="off"></label>
                <label class="fld"><span class="lb">κ среды, См/м</span><input id="zeta-kappa" inputmode="decimal" autocomplete="off"></label>
              </div>
              <label class="chk"><input type="checkbox" id="zeta-surf"> <span>поправка на поверхностную проводимость</span></label>
              <div class="fields" id="zeta-surf-f" hidden>
