/* LabColloid — лабораторный прибор на экране: спокойные нейтрали с холодным уклоном, один синий акцент,
   данные и результаты цифрами с выравниванием по разрядам. Нижняя панель на телефоне, боковая — на широком экране. */
:root {
  --bg: #f1f4f7;
  --surface: #ffffff;
  --surface2: #f6f8fa;
  --ink: #0f1c26;
  --ink2: #4b5b68;
  --ink3: #7a8995;
  --line: #dce3e9;
  --line2: #c8d2da;
  --accent: #0b5cad;
  --accent-ink: #ffffff;
  --accent-soft: #e5eff9;
  --c1: #0b5cad;
  --c2: #d2680a;
  --c3: #0d8a74;
  --c4: #b02f87;
  --c5: #7d8b97;
  --good: #17784a;
  --good-soft: #e4f4ec;
  --warn: #a35f00;
  --warn-soft: #fbf0dc;
  --bad: #b8332a;
  --bad-soft: #fbe8e6;
  --info-soft: #e5eff9;
  --grid: #e4eaef;
  --shadow: 0 1px 2px rgba(15, 28, 38, .05);
  --font: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  --nav-h: 62px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0c1319; --surface: #141d25; --surface2: #19242e; --ink: #e6edf2; --ink2: #9fb0bd; --ink3: #738490;
    --line: #26323c; --line2: #35444f; --accent: #5ea4f2; --accent-ink: #06121d; --accent-soft: #14283c;
    --c1: #5ea4f2; --c2: #f09a4a; --c3: #3fc4aa; --c4: #e578c3; --c5: #8b9aa6;
    --good: #4cc38a; --good-soft: #12281f; --warn: #e8a63e; --warn-soft: #2c2210; --bad: #f2716a; --bad-soft: #301a19;
    --info-soft: #14283c; --grid: #222d36; --shadow: none; color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0c1319; --surface: #141d25; --surface2: #19242e; --ink: #e6edf2; --ink2: #9fb0bd; --ink3: #738490;
  --line: #26323c; --line2: #35444f; --accent: #5ea4f2; --accent-ink: #06121d; --accent-soft: #14283c;
  --c1: #5ea4f2; --c2: #f09a4a; --c3: #3fc4aa; --c4: #e578c3; --c5: #8b9aa6;
  --good: #4cc38a; --good-soft: #12281f; --warn: #e8a63e; --warn-soft: #2c2210; --bad: #f2716a; --bad-soft: #301a19;
  --info-soft: #14283c; --grid: #222d36; --shadow: none; color-scheme: dark;
}

* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0; background: var(--bg); color: var(--ink);
  font: 15px/1.45 var(--font); font-variant-numeric: tabular-nums;
  -webkit-tap-highlight-color: transparent;
}
button, input, select, textarea { font: inherit; color: inherit; }
b, strong { font-weight: 650; }
h1, h2, h3 { margin: 0; text-wrap: balance; }
p { margin: 0; }
sub, sup { line-height: 0; }

/* ---------- каркас ---------- */
.shell { display: grid; grid-template-columns: minmax(0, 1fr); min-height: 100vh;
  grid-template-areas: "top" "main" "foot" "nav"; }
.top { grid-area: top; padding: 14px max(16px, env(safe-area-inset-left, 0px)) 6px max(16px, env(safe-area-inset-right, 0px)); }
.brand { display: flex; gap: 12px; align-items: center; }
.logo { width: 38px; height: 38px; flex: none; }
.logo-bg { fill: var(--accent); }
.logo-curve { fill: none; stroke: var(--accent-ink); stroke-width: 2.4; stroke-linecap: round; }
.logo-dot { fill: var(--accent-ink); }
.brand h1 { font-size: 19px; letter-spacing: -.01em; line-height: 1.15; }
.brand p { font-size: 12.5px; color: var(--ink2); line-height: 1.3; }

.nav { grid-area: nav; position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; display: flex;
  background: var(--surface); background: color-mix(in srgb, var(--surface) 94%, transparent); backdrop-filter: saturate(1.4) blur(14px);
  -webkit-backdrop-filter: saturate(1.4) blur(14px); border-top: 1px solid var(--line);
  padding: 6px max(16px, env(safe-area-inset-left, 0px)) calc(6px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-right, 0px)); gap: 6px; }
.nav button { flex: 1 1 0; min-width: 0; min-height: 50px; border: 0; background: none; border-radius: 12px; color: var(--ink2);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; cursor: pointer; font-size: 11.5px; font-weight: 550; }
.nav svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.nav button[aria-selected="true"] { color: var(--accent); background: var(--accent-soft); }
.main { grid-area: main; padding: 6px max(16px, env(safe-area-inset-left, 0px)) 24px max(16px, env(safe-area-inset-right, 0px)); min-width: 0; }
.foot { grid-area: foot; padding: 4px max(16px, env(safe-area-inset-left, 0px)) calc(var(--nav-h) + 28px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-right, 0px));
  font-size: 12.5px; color: var(--ink2); display: grid; gap: 8px; max-width: 70ch; }
.linkbtn { border: 0; background: none; padding: 8px 0; min-height: 40px; color: var(--accent); font-weight: 550; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }

@media (min-width: 900px) {
  .shell { grid-template-columns: 220px minmax(0, 1fr); grid-template-rows: auto 1fr auto;
    grid-template-areas: "top top" "nav main" "nav foot"; }
  .nav { position: sticky; top: 16px; align-self: start; flex-direction: column; border: 0; background: none; backdrop-filter: none; -webkit-backdrop-filter: none;
    padding: 12px 8px 12px max(16px, env(safe-area-inset-left, 0px)); gap: 4px; }
  .nav button { flex: none; flex-direction: row; justify-content: flex-start; gap: 12px; min-height: 46px; padding: 0 14px; font-size: 14.5px; }
  .foot { padding-bottom: 32px; }
  .top { padding-top: 22px; }
}

/* ---------- модули и карточки ---------- */
.mod { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; max-width: 1180px; }
.mod-head { padding: 8px 0 2px; }
.mod-head h2 { font-size: 22px; letter-spacing: -.012em; line-height: 1.2; }
.mod-head p { color: var(--ink2); font-size: 14px; margin-top: 4px; max-width: 62ch; }
.grid2 { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 430px), 1fr)); align-items: start; }
.col { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; min-width: 0; }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 16px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; min-width: 0; box-shadow: var(--shadow); }
.card h3 { font-size: 15.5px; letter-spacing: -.005em; }
.sub { font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink2); font-weight: 650; padding-top: 4px; }
.hint { font-size: 12.8px; color: var(--ink2); line-height: 1.45; }
.hint:empty { display: none; }

/* ---------- элементы форм ---------- */
.fields { display: grid; gap: 10px 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); }
.fld { display: grid; gap: 5px; min-width: 0; align-content: start; }
.lb { font-size: 12.5px; color: var(--ink2); line-height: 1.25; }
input[type="text"], input:not([type]), select, textarea {
  width: 100%; min-height: 44px; padding: 9px 11px; font-size: 16px; background: var(--surface2); color: var(--ink);
  border: 1px solid var(--line); border-radius: 10px; outline: none; appearance: none; -webkit-appearance: none; min-width: 0; }
select { background-image: linear-gradient(45deg, transparent 50%, var(--ink2) 50%), linear-gradient(135deg, var(--ink2) 50%, transparent 50%);
  background-position: calc(100% - 18px) 55%, calc(100% - 13px) 55%; background-size: 5px 5px, 5px 5px; background-repeat: no-repeat; padding-right: 32px; text-overflow: ellipsis; }
textarea { resize: vertical; font-family: var(--mono); font-size: 14px; min-height: 90px; }
input[readonly] { color: var(--ink2); background: transparent; }
input:focus-visible, select:focus-visible, textarea:focus-visible { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent); }
::placeholder { color: var(--ink3); }
.pair { display: grid; grid-template-columns: 1fr auto 1fr; gap: 8px; align-items: center; color: var(--ink2); }

.btn { min-height: 44px; padding: 0 16px; border-radius: 10px; border: 1px solid var(--line2); background: var(--surface); color: var(--ink);
  font-weight: 550; cursor: pointer; font-size: 14.5px; }
.btn:active { background: var(--surface2); }
.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.btn.primary:active { filter: brightness(.92); }
.btn:focus-visible, .nav button:focus-visible, .seg button:focus-visible, .linkbtn:focus-visible, summary:focus-visible, .del:focus-visible {
  outline: 2px solid var(--accent); outline-offset: 2px; }
.btn-row, .demo-row { display: flex; flex-wrap: wrap; gap: 8px; }
.demo-row select { flex: 1 1 200px; width: auto; }
.demo-row .btn { flex: 0 0 auto; }

.seg { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 96px), 1fr)); gap: 4px; padding: 3px; background: var(--surface2); border: 1px solid var(--line); border-radius: 12px; }
.seg button { min-width: 0; overflow-wrap: anywhere; min-height: 40px; padding: 6px 6px; border: 0; border-radius: 9px; background: none; color: var(--ink2); font-size: 14px; font-weight: 550; cursor: pointer; line-height: 1.2; }
.seg button[aria-checked="true"] { background: var(--surface); color: var(--accent); box-shadow: 0 0 0 1px var(--line2), 0 1px 2px rgba(0, 0, 0, .06); }
.seg.tabs button { font-size: 13.5px; padding: 6px 8px; }

.chk { display: flex; gap: 10px; align-items: center; min-height: 44px; cursor: pointer; font-size: 14.5px; }
.chk input { width: 22px; height: 22px; accent-color: var(--accent); flex: none; margin: 0; }
.slider { display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: center; }
.slider input { width: 100%; accent-color: var(--accent); min-height: 32px; }
.slider output { font-size: 13.5px; font-weight: 600; min-width: 4.5ch; text-align: right; }
#sed-tau-o { text-align: left; grid-column: 1 / -1; font-weight: 500; color: var(--ink2); }
#sed-tau-o b { color: var(--ink); }
.tctl { display: grid; gap: 4px; }

details { min-width: 0; }
summary { cursor: pointer; font-weight: 600; font-size: 14.5px; min-height: 44px; display: flex; align-items: center; gap: 8px; list-style: none; border-radius: 8px; }
summary::-webkit-details-marker { display: none; }
summary::before { content: ""; width: 7px; height: 7px; border-right: 2px solid var(--ink2); border-bottom: 2px solid var(--ink2); transform: rotate(-45deg); transition: transform .15s; flex: none; margin-right: 4px; }
details[open] > summary::before { transform: rotate(45deg); }
.imp-body { display: grid; gap: 10px; padding: 2px 0 6px; }
.imp-body input[type="file"] { font-size: 14px; max-width: 100%; }

/* ---------- таблицы ---------- */
.table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; -webkit-overflow-scrolling: touch; }
table { border-collapse: collapse; width: 100%; }
.dt th, .dt td { padding: 0; border-bottom: 1px solid var(--line); }
.dt tbody tr:last-child td { border-bottom: 0; }
.dt th { font-size: 12.5px; color: var(--ink2); font-weight: 650; text-align: left; padding: 8px 10px; background: var(--surface2); white-space: nowrap; }
.dt td.n, .dt th.n { width: 34px; text-align: center; color: var(--ink3); font-size: 12.5px; padding: 0 4px; }
.dt td.x, .dt th.x { width: 44px; }
.dt input { border: 0; border-radius: 0; background: transparent; min-height: 44px; padding: 0 10px; }
.dt input:focus-visible { box-shadow: inset 0 0 0 2px var(--accent); }
.del { width: 44px; height: 44px; border: 0; background: none; color: var(--ink3); font-size: 22px; line-height: 1; cursor: pointer; }
.del:active { color: var(--bad); }

.rt { font-size: 13.5px; }
.rt th, .rt td { padding: 8px 7px; border-bottom: 1px solid var(--line); text-align: right; white-space: nowrap; }
.rt th:first-child, .rt td:first-child { text-align: left; white-space: normal; color: var(--ink2); min-width: 78px; }
.rt thead th { background: var(--surface2); font-size: 12.5px; font-weight: 650; color: var(--ink2); }
.rt tbody tr:last-child td { border-bottom: 0; }
.rt td.muted, .rt .muted { color: var(--ink3); }
.rt tbody th { font-weight: 500; text-align: left; color: var(--ink2); }
.rt .neg { color: var(--ink3); font-style: italic; }
.rt .del { width: 36px; height: 36px; font-size: 19px; }
.rt:empty { display: none; }
.table-wrap:has(.rt:empty) { display: none; }

/* ---------- результаты ---------- */
.kpis { display: grid; gap: 8px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 128px), 1fr)); }
.kpis:empty { display: none; }
.kpi { background: var(--surface2); border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; display: grid; gap: 1px; min-width: 0; align-content: start; }
.kpi .k { font-size: 12px; color: var(--ink2); line-height: 1.25; }
.kpi .v { font-size: 21px; font-weight: 650; letter-spacing: -.01em; line-height: 1.2; overflow-wrap: anywhere; }
.kpi .u { font-size: 12.5px; color: var(--ink2); font-weight: 450; margin-left: 3px; }
.kpi .s { font-size: 12px; color: var(--ink2); line-height: 1.3; }
.kpi.rng .v { font-size: 17px; white-space: nowrap; }
.kpi.hl { background: var(--accent-soft); border-color: color-mix(in srgb, var(--accent) 30%, var(--line)); }
.kpi.hl .v { color: var(--accent); }

.msg { border-radius: 10px; padding: 9px 12px; font-size: 13.5px; line-height: 1.4; border: 1px solid transparent; margin-bottom: 8px; }
.msg.err { background: var(--bad-soft); border-color: color-mix(in srgb, var(--bad) 35%, transparent); }
.msg.warn { background: var(--warn-soft); border-color: color-mix(in srgb, var(--warn) 35%, transparent); }
.msg.info { background: var(--info-soft); border-color: color-mix(in srgb, var(--accent) 25%, transparent); }
.msg b { font-weight: 650; }
.msg.err b { color: var(--bad); } .msg.warn b { color: var(--warn); } .msg.info b { color: var(--accent); }
#ads-msgs:empty, #sed-msgs:empty, #zeta-msgs:empty { display: none; }

.chip { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 99px; font-size: 13px; font-weight: 600; background: var(--surface2); border: 1px solid var(--line); }
.chip.ok, .chip.good { background: var(--good-soft); color: var(--good); border-color: color-mix(in srgb, var(--good) 35%, transparent); }
.chip.warn { background: var(--warn-soft); color: var(--warn); border-color: color-mix(in srgb, var(--warn) 35%, transparent); }
.chip.bad { background: var(--bad-soft); color: var(--bad); border-color: color-mix(in srgb, var(--bad) 35%, transparent); }

/* ---------- ζ-потенциал ---------- */
.zhead { display: grid; gap: 2px; }
.zbig { font-size: 38px; font-weight: 650; letter-spacing: -.02em; line-height: 1.1; }
.zbig .u { font-size: 17px; color: var(--ink2); font-weight: 500; margin-left: 4px; letter-spacing: 0; }
.zsign { font-size: 13.5px; color: var(--ink2); }
.gauge { position: relative; height: 62px; margin: 12px 4px 4px; }
.g-bar { position: absolute; left: 0; right: 0; top: 24px; height: 14px; border-radius: 7px; overflow: hidden; background: var(--bad-soft); border: 1px solid var(--line); }
.g-zone { position: absolute; top: 0; bottom: 0; background: var(--good-soft); }
.g-zero { position: absolute; top: 20px; height: 22px; width: 1px; background: var(--line2); }
.g-mark { position: absolute; top: 14px; width: 4px; height: 34px; margin-left: -2px; border-radius: 2px; background: var(--ink); box-shadow: 0 0 0 2px var(--surface); }
.g-val { position: absolute; top: -4px; transform: translateX(-50%); font-size: 12.5px; font-weight: 650; white-space: nowrap; background: var(--ink); color: var(--bg); border-radius: 6px; padding: 1px 7px; }
.g-tick { position: absolute; top: 46px; transform: translateX(-50%); font-size: 11.5px; color: var(--ink2); }
.verdict { display: grid; gap: 4px; }
.verdict .chip { justify-self: start; }
.kv { display: grid; grid-template-columns: 1fr auto; gap: 6px 14px; font-size: 14px; margin: 0; }
.kv dt { color: var(--ink2); } .kv dd { margin: 0; text-align: right; font-weight: 600; }
.kv + .kv { margin-top: 0; }

/* ---------- формулы ---------- */
.formulas { padding-top: 4px; padding-bottom: 4px; }
.fbody { display: grid; gap: 18px; padding: 4px 0 14px; }
.fblock { display: grid; gap: 6px; min-width: 0; }
.fblock .ft { font-weight: 650; font-size: 14.5px; }
.fblock p { font-size: 13.8px; color: var(--ink2); max-width: 64ch; }
.fblock p b { color: var(--ink); }
.math { overflow-x: auto; overflow-y: hidden; padding: 2px 0; }
.math .katex-display { margin: .35em 0; text-align: left; }
.math .katex-display > .katex { text-align: left; }
.math .katex { font-size: 1.12em; color: var(--ink); }

/* ---------- графики ---------- */
.chart { position: relative; min-width: 0; }
.chart-legend { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12.5px; color: var(--ink2); padding: 0 2px 6px; }
.chart-legend .lg { display: inline-flex; align-items: center; gap: 5px; }
.chart-plot svg { display: block; width: 100%; height: auto; touch-action: pan-y; overflow: hidden; }
.chart svg text { font-family: var(--font); font-variant-numeric: tabular-nums; }
.chart .grid line { stroke: var(--grid); stroke-width: 1; }
.chart .grid line.zero { stroke: var(--line2); stroke-width: 1.2; }
.chart .axes line { stroke: var(--line2); stroke-width: 1.2; }
.chart .ticks text { fill: var(--ink2); font-size: 11px; }
.chart .axt { fill: var(--ink2); font-size: 12px; }
.chart .lbl { font-size: 11.5px; font-weight: 650; paint-order: stroke; stroke: var(--surface); stroke-width: 3.5px; stroke-linejoin: round; }
.chart .ln { fill: none; stroke-linejoin: round; stroke-linecap: round; }
.chart .ring { fill: none; stroke-width: 2; pointer-events: none; }
.chart-tip { position: absolute; z-index: 5; pointer-events: none; max-width: 230px; padding: 6px 9px; border-radius: 8px; font-size: 12.5px; line-height: 1.35;
  background: var(--ink); color: var(--bg); box-shadow: 0 4px 14px rgba(0, 0, 0, .22); white-space: nowrap; }
.chart-tip b { font-weight: 650; }
#ads-chart, #sed-chart, #zeta-chart { min-height: 0; }
#zeta-chart[hidden] { display: none; }

.toast { position: fixed; left: 50%; transform: translateX(-50%); bottom: calc(var(--nav-h) + 18px + env(safe-area-inset-bottom, 0px)); z-index: 40;
  background: var(--ink); color: var(--bg); padding: 10px 16px; border-radius: 99px; font-size: 14px; font-weight: 550; box-shadow: 0 6px 20px rgba(0, 0, 0, .25); max-width: calc(100vw - 32px); }
@media (min-width: 900px) { .toast { bottom: 28px; } }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; scroll-behavior: auto !important; } }
@media (max-width: 380px) {
  .zbig { font-size: 32px; }
  .kpi .v { font-size: 19px; }
  .card { padding: 14px; }
}
</style>
</head>
<body>
<div class="shell" id="app">
  <header class="top">
    <div class="brand">
      <svg class="logo" viewBox="0 0 40 40" aria-hidden="true">
        <rect width="40" height="40" rx="10" class="logo-bg"/>
        <path d="M7 31 C 13 14, 22 10, 33 10" class="logo-curve"/>
        <circle cx="11" cy="24" r="2.2" class="logo-dot"/><circle cx="18" cy="16.6" r="2.2" class="logo-dot"/>
        <circle cx="26" cy="12" r="2.2" class="logo-dot"/><circle cx="33" cy="10" r="2.2" class="logo-dot"/>
      </svg>
      <div>
        <h1>LabColloid</h1>
        <p>Калькулятор для практикума по коллоидной химии</p>
      </div>
    </div>
  </header>

  <nav class="nav" id="nav" aria-label="Модули" role="tablist">
    <button role="tab" data-tab="ads" aria-selected="true">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 20 C 7 8, 12 6, 21 6"/><circle cx="5.5" cy="15" r="1.4"/><circle cx="10" cy="9.5" r="1.4"/><circle cx="16" cy="6.8" r="1.4"/></svg>
      <span>Адсорбция</span>
    </button>
    <button role="tab" data-tab="sed" aria-selected="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 20 L3 4"/><path d="M3 20 L21 20"/><path d="M4 19 C 7 9, 11 6, 20 5.5"/></svg>
      <span>Седиментация</span>
    </button>
    <button role="tab" data-tab="zeta" aria-selected="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4 H17 L8 12 C 12 11 17 12.5 16.5 16.5 C 16 20 12 20.5 9 19"/></svg>
      <span>ζ-потенциал</span>
    </button>
  </nav>

  <main class="main">

  <!-- ===================== МОДУЛЬ 1: АДСОРБЦИЯ ===================== -->
  <section class="mod" id="mod-ads" role="tabpanel">
    <div class="mod-head">
      <h2>Модели адсорбции</h2>
      <p>Ленгмюр, БЭТ и Фрейндлих по линейным анаморфозам, удельная поверхность по ёмкости монослоя.</p>
    </div>
    <div class="grid2">
      <div class="col">
        <article class="card">
          <h3>Данные изотермы</h3>
          <div class="demo-row">
            <select id="ads-demo" aria-label="Пример данных"></select>
            <button class="btn primary" id="ads-load" type="button">Загрузить пример данных</button>
          </div>
          <p class="hint" id="ads-demo-note"></p>
          <div class="fields">
            <div class="fld"><span class="lb">Ось x</span>
              <div class="seg" id="ads-xtype" role="radiogroup" aria-label="Что по оси x">
                <button type="button" role="radio" data-v="c">c, раствор</button>
                <button type="button" role="radio" data-v="pps">p/pₛ</button>
                <button type="button" role="radio" data-v="p">p, Па</button>
              </div>
            </div>
            <label class="fld"><span class="lb">Единицы x</span><select id="ads-xunit"></select></label>
            <label class="fld"><span class="lb">Единицы A</span><select id="ads-aunit"></select></label>
          </div>
          <div class="table-wrap">
            <table class="dt" id="ads-table">
              <thead><tr><th class="n">№</th><th id="ads-xh">c</th><th id="ads-ah">A</th><th class="x"></th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
          <div class="btn-row">
            <button class="btn" id="ads-add" type="button">+ Строка</button>
            <button class="btn" id="ads-clear" type="button">Очистить таблицу</button>
          </div>
          <details class="imp">
            <summary>Загрузить CSV или вставить из таблицы</summary>
            <div class="imp-body">
              <input type="file" id="ads-file" accept=".csv,.txt,text/csv,text/plain" aria-label="Файл CSV">
              <textarea id="ads-paste" rows="4" placeholder="Две колонки: x и A. Разделитель: пробел, табуляция, «;» или «,». Десятичная запятая допустима."></textarea>
              <button class="btn" id="ads-apply" type="button">Применить вставленный текст</button>
            </div>
          </details>
        </article>

        <article class="card">
          <h3>Параметры</h3>
          <div class="fields">
            <label class="fld"><span class="lb">s₀, нм² (площадка молекулы)</span><input id="ads-s0" inputmode="decimal" autocomplete="off"></label>
            <label class="fld"><span class="lb">M сорбата, г/моль</span><input id="ads-M" inputmode="decimal" autocomplete="off"></label>
            <label class="fld"><span class="lb">T, К</span><input id="ads-T" inputmode="decimal" autocomplete="off"></label>
            <label class="fld" id="ads-ps-wrap"><span class="lb">pₛ, в тех же единицах, что p</span><input id="ads-ps" inputmode="decimal" autocomplete="off"></label>
            <div class="fld"><span class="lb">Интервал БЭТ, p/pₛ</span>
              <span class="pair"><input id="ads-blo" inputmode="decimal" aria-label="От" autocomplete="off"><span>–</span><input id="ads-bhi" inputmode="decimal" aria-label="До" autocomplete="off"></span>
            </div>
          </div>
          <div class="fld"><span class="lb">Как оценивать параметры</span>
            <div class="seg" id="ads-method" role="radiogroup" aria-label="Метод оценки">
              <button type="button" role="radio" data-v="lin">Линейная анаморфоза</button>
              <button type="button" role="radio" data-v="nl">Нелинейная МНК</button>
            </div>
          </div>
          <p class="hint">Линейная анаморфоза — как в практикуме. Нелинейная МНК подгоняет саму изотерму A(c), поэтому она не искажает вес точек.</p>
        </article>
      </div>

      <div class="col">
        <article class="card" id="ads-res-card">
          <h3>Результаты</h3>
          <div id="ads-msgs"></div>
          <div id="ads-kpis" class="kpis"></div>
          <div class="table-wrap"><table class="rt" id="ads-rt"></table></div>
          <div id="ads-thermo" class="hint"></div>
          <div class="btn-row"><button class="btn" id="ads-copy" type="button">Копировать таблицу</button></div>
        </article>
        <article class="card">
          <h3>Графики</h3>
          <div class="seg tabs" id="ads-ctab" role="radiogroup" aria-label="График">
            <button type="button" role="radio" data-v="iso">Изотерма</button>
            <button type="button" role="radio" data-v="lang">Ленгмюр</button>
            <button type="button" role="radio" data-v="bet">БЭТ</button>
            <button type="button" role="radio" data-v="fre">Фрейндлих</button>
          </div>
          <div id="ads-chart"></div>
          <p class="hint" id="ads-chart-note"></p>
        </article>
      </div>
    </div>

    <article class="card formulas">
      <details>
        <summary>Формулы и физический смысл параметров</summary>
        <div class="fbody">
          <div class="fblock"><div class="ft">Ленгмюр (мономолекулярная адсорбция)</div>
            <div class="math"><span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi>A</mi><mo>=</mo><msub><mi>A</mi><mi mathvariant="normal">∞</mi></msub><mtext> </mtext><mstyle scriptlevel="0" displaystyle="true"><mfrac><mrow><mi>K</mi><mtext> </mtext><mi>c</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>K</mi><mtext> </mtext><mi>c</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">A = A_\infty\,\dfrac{K\,c}{1+K\,c}</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height:0.6833em;"></span><span class="mord mathnormal">A</span><span class="mspace" style="margin-right:0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right:0.2778em;"></span></span><span class="base"><span class="strut" style="height:2.1297em;vertical-align:-0.7693em;"></span><span class="mord"><span class="mord mathnormal">A</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.1514em;"><span style="top:-2.55em;margin-left:0em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight">∞</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.15em;"><span></span></span></span></span></span></span><span class="mspace" style="margin-right:0.1667em;"></span><span class="mord"><span class="mopen nulldelimiter"></span><span class="mfrac"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:1.3603em;"><span style="top:-2.314em;"><span class="pstrut" style="height:3em;"></span><span class="mord"><span class="mord">1</span><span class="mspace" style="margin-right:0.2222em;"></span><span class="mbin">+</span><span class="mspace" style="margin-right:0.2222em;"></span><span class="mord mathnormal" style="margin-right:0.0715em;">K</span><span class="mspace" style="margin-right:0.1667em;"></span><span class="mord mathnormal">c</span></span></span><span style="top:-3.23em;"><span class="pstrut" style="height:3em;"></span><span class="frac-line" style="border-bottom-width:0.04em;"></span></span><span style="top:-3.677em;"><span class="pstrut" style="height:3em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right:0.0715em;">K</span><span class="mspace" style="margin-right:0.1667em;"></span><span class="mord mathnormal">c</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.7693em;"><span></span></span></span></span></span><span class="mclose nulldelimiter"></span></span></span></span></span></span></div>
            <div class="math"><span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mstyle scriptlevel="0" displaystyle="true"><mfrac><mn>1</mn><mi>A</mi></mfrac></mstyle><mo>=</mo><mstyle scriptlevel="0" displaystyle="true"><mfrac><mn>1</mn><msub><mi>A</mi><mi mathvariant="normal">∞</mi></msub></mfrac></mstyle><mo>+</mo><mstyle scriptlevel="0" displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>A</mi><mi mathvariant="normal">∞</mi></msub><mi>K</mi></mrow></mfrac></mstyle><mo>⋅</mo><mstyle scriptlevel="0" displaystyle="true"><mfrac><mn>1</mn><mi>c</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\dfrac{1}{A} = \dfrac{1}{A_\infty} + \dfrac{1}{A_\infty K}\cdot\dfrac{1}{c}</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height:2.0074em;vertical-align:-0.686em;"></span><span class="mord"><span class="mopen nulldelimiter"></span><span class="mfrac"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:1.3214em;"><span style="top:-2.314em;"><span class="pstrut" style="height:3em;"></span><span class="mord"><span class="mord mathnormal">A</span></span></span><span style="top:-3.23em;"><span class="pstrut" style="height:3em;"></span><span class="frac-line" style="border-bottom-width:0.04em;"></span></span><span style="top:-3.677em;"><span class="pstrut" style="height:3em;"></span><span class="mord"><span class="mord">1</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.686em;"><span></span></span></span></span></span><span class="mclose nulldelimiter"></span></span><span class="mspace" style="margin-right:0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right:0.2778em;"></span></span><span class="base"><span class="strut" style="height:2.1574em;vertical-align:-0.836em;"></span><span class="mord"><span class="mopen nulldelimiter"></span><span class="mfrac"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:1.3214em;"><span style="top:-2.314em;"><span class="pstrut" style="height:3em;"></span><span class="mord"><span class="mord"><span class="mord mathnormal">A</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.1514em;"><span style="top:-2.55em;margin-left:0em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight">∞</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.15em;"><span></span></span></span></span></span></span></span></span><span style="top:-3.23em;"><span class="pstrut" style="height:3em;"></span><span class="frac-line" style="border-bottom-width:0.04em;"></span></span><span style="top:-3.677em;"><span class="pstrut" style="height:3em;"></span><span class="mord"><span class="mord">1</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.836em;"><span></span></span></span></span></span><span class="mclose nulldelimiter"></span></span><span class="mspace" style="margin-right:0.2222em;"></span><span class="mbin">+</span><span class="mspace" style="margin-right:0.2222em;"></span></span><span class="base"><span class="strut" style="height:2.1574em;vertical-align:-0.836em;"></span><span class="mord"><span class="mopen nulldelimiter"></span><span class="mfrac"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:1.3214em;"><span style="top:-2.314em;"><span class="pstrut" style="height:3em;"></span><span class="mord"><span class="mord"><span class="mord mathnormal">A</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.1514em;"><span style="top:-2.55em;margin-left:0em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight">∞</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.15em;"><span></span></span></span></span></span></span><span class="mord mathnormal" style="margin-right:0.0715em;">K</span></span></span><span style="top:-3.23em;"><span class="pstrut" style="height:3em;"></span><span class="frac-line" style="border-bottom-width:0.04em;"></span></span><span style="top:-3.677em;"><span class="pstrut" style="height:3em;"></span><span class="mord"><span class="mord">1</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.836em;"><span></span></span></span></span></span><span class="mclose nulldelimiter"></span></span><span class="mspace" style="margin-right:0.2222em;"></span><span class="mbin">⋅</span><span class="mspace" style="margin-right:0.2222em;"></span></span><span class="base"><span class="strut" style="height:2.0074em;vertical-align:-0.686em;"></span><span class="mord"><span class="mopen nulldelimiter"></span><span class="mfrac"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:1.3214em;"><span style="top:-2.314em;"><span class="pstrut" style="height:3em;"></span><span class="mord"><span class="mord mathnormal">c</span></span></span><span style="top:-3.23em;"><span class="pstrut" style="height:3em;"></span><span class="frac-line" style="border-bottom-width:0.04em;"></span></span><span style="top:-3.677em;"><span class="pstrut" style="height:3em;"></span><span class="mord"><span class="mord">1</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.686em;"><span></span></span></span></span></span><span class="mclose nulldelimiter"></span></span></span></span></span></span></div>
            <p><b>A∞</b> — ёмкость монослоя, предельная адсорбция при заполнении всех центров. <b>K</b> — константа адсорбционного равновесия: чем больше K, тем круче начальный участок изотермы. По отсечке находят A∞, по наклону K.</p>
          </div>
          <div class="fblock"><div class="ft">БЭТ (полимолекулярная адсорбция паров)</div>
