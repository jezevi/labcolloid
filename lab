    const slope = sxy / sxx;
    const intercept = my - slope * mx;
    const r2 = syy > 0 ? (sxy * sxy) / (sxx * syy) : NaN;
    let seSlope = NaN, seInt = NaN;
    if (n > 2) {
      const s2 = Math.max(0, syy - slope * sxy) / (n - 2);
      seSlope = Math.sqrt(s2 / sxx);
      seInt = Math.sqrt(s2 * (1 / n + (mx * mx) / sxx));
    }
    return { ok: true, n, slope, intercept, r2, seSlope, seInt };
  }

  function r2Of(yObs, yMod) {
    const n = yObs.length;
    if (n < 2) return NaN;
    let m = 0; for (let i = 0; i < n; i++) m += yObs[i]; m /= n;
    let ssr = 0, sst = 0;
    for (let i = 0; i < n; i++) {
      ssr += (yObs[i] - yMod[i]) ** 2; sst += (yObs[i] - m) ** 2;
    }
    return sst > 0 ? 1 - ssr / sst : NaN;
  }

  // решение маленькой системы A·x = b (Гаусс с выбором главного элемента)
  function solveLin(A, b) {
    const n = b.length;
    const M = A.map((r, i) => r.slice().concat([b[i]]));
    for (let k = 0; k < n; k++) {
      let p = k;
      for (let i = k + 1; i < n; i++) if (Math.abs(M[i][k]) > Math.abs(M[p][k])) p = i;
      if (Math.abs(M[p][k]) < 1e-300) return null;
      if (p !== k) { const t = M[p]; M[p] = M[k]; M[k] = t; }
      for (let i = k + 1; i < n; i++) {
        const f = M[i][k] / M[k][k];
        for (let j = k; j <= n; j++) M[i][j] -= f * M[k][j];
      }
    }
    const x = new Array(n);
    for (let i = n - 1; i >= 0; i--) {
      let s = M[i][n];
      for (let j = i + 1; j < n; j++) s -= M[i][j] * x[j];
      x[i] = s / M[i][i];
    }
    return x.every(Number.isFinite) ? x : null;
  }

  // Левенберг—Марквардт; параметры ищутся в логарифмической шкале (p = exp(θ) > 0)
  function fitLM(model, theta0, xs, ys) {
    const k = theta0.length, n = xs.length;
    let th = theta0.slice();
    const rssOf = (t) => {
      const p = t.map(Math.exp); let s = 0;
      for (let i = 0; i < n; i++) { const d = ys[i] - model(p, xs[i]); s += d * d; }
      return Number.isFinite(s) ? s : Infinity;
    };
    let rss = rssOf(th), lam = 1e-3, converged = false;
    if (!Number.isFinite(rss)) return { ok: false, reason: 'начальное приближение вне области определения' };
    for (let it = 0; it < 300; it++) {
      const J = [], r = [];
      const p0 = th.map(Math.exp);
      for (let i = 0; i < n; i++) r.push(ys[i] - model(p0, xs[i]));
      for (let j = 0; j < k; j++) {
        const hh = 1e-6 * Math.max(1, Math.abs(th[j]));
        const tp = th.slice(), tm = th.slice(); tp[j] += hh; tm[j] -= hh;
        const pp = tp.map(Math.exp), pm = tm.map(Math.exp);
        const col = [];
        for (let i = 0; i < n; i++) col.push((model(pp, xs[i]) - model(pm, xs[i])) / (2 * hh));
        J.push(col);
      }
      const JTJ = [], JTr = [];
      for (let a = 0; a < k; a++) {
        JTJ.push([]);
        let g = 0; for (let i = 0; i < n; i++) g += J[a][i] * r[i];
        JTr.push(g);
        for (let b = 0; b < k; b++) { let s = 0; for (let i = 0; i < n; i++) s += J[a][i] * J[b][i]; JTJ[a].push(s); }
      }
      let improved = false;
      for (let tries = 0; tries < 30; tries++) {
        const A = JTJ.map((row, a) => row.map((v, b) => (a === b ? v * (1 + lam) + 1e-300 : v)));
        const d = solveLin(A, JTr);
        if (!d) { lam *= 10; continue; }
        const nt = th.map((v, a) => v + d[a]);
        const nr = rssOf(nt);
        if (nr < rss) {
          const dmax = Math.max(...d.map(Math.abs));
          const rel = (rss - nr) / Math.max(rss, 1e-300);
          th = nt; rss = nr; lam = Math.max(lam / 3, 1e-12); improved = true;
          if (dmax < 1e-10 || rel < 1e-13) converged = true;
          break;
        } else lam *= 4;
        if (lam > 1e12) break;
      }
      if (!improved) { converged = true; break; }
      if (converged) break;
    }
    return { ok: true, p: th.map(Math.exp), rss, converged };
  }

  /* ======================================================================
     МОДУЛЬ 1. АДСОРБЦИЯ
     ====================================================================== */
  const A_UNITS = {
    'mol/kg': { label: 'моль/кг', mass: false, toMolKg: (a) => a },
    'mmol/g': { label: 'ммоль/г', mass: false, toMolKg: (a) => a },
    'mol/g':  { label: 'моль/г', mass: false, toMolKg: (a) => a * 1000 },
    'g/kg':   { label: 'г/кг', mass: true, toMolKg: (a, M) => a / M },
    'mg/g':   { label: 'мг/г', mass: true, toMolKg: (a, M) => a / M },
    'g/g':    { label: 'г/г', mass: true, toMolKg: (a, M) => (a * 1000) / M },
    'cm3/g':  { label: 'см³(н.у.)/г', mass: false, toMolKg: (a) => (a * 1000) / (CONST.VM_STP * 1000) },
    'm3/kg':  { label: 'м³(н.у.)/кг', mass: false, toMolKg: (a) => a / (CONST.VM_STP / 1000) }
  };
  const X_UNITS = {
    c:   { M: { label: 'моль/л', f: 1 }, mM: { label: 'ммоль/л', f: 1e-3 } },
    pps: { one: { label: '—', f: 1 } },
    p:   { Pa: { label: 'Па', f: 1 }, kPa: { label: 'кПа', f: 1000 } }
  };

  const langmuirA = (p, x) => (p[0] * p[1] * x) / (1 + p[1] * x);
  const betA = (p, x) => (p[0] * p[1] * x) / ((1 - x) * (1 + (p[1] - 1) * x));
  const freundlichA = (p, x) => p[0] * Math.pow(x, p[1]);

  function surfaceArea(AinfMolKg, s0nm2) { // м²/г
    return (AinfMolKg / 1000) * CONST.NA * s0nm2 * 1e-18;
  }

  function adsorption(inp) {
    const out = { ok: false, warnings: [], errors: [], notes: [] };
    const au = A_UNITS[inp.aUnit];
    const xu = (X_UNITS[inp.xType] || {})[inp.xUnit];
    if (!au || !xu) { out.errors.push('Не выбраны единицы измерения.'); return out; }
    const M = parseNum(inp.M), s0 = parseNum(inp.s0), T = parseNum(inp.T);
    let ps = parseNum(inp.ps);
    if (au.mass && !(M > 0)) {
      out.errors.push('Адсорбция задана в массовых единицах: укажите молярную массу сорбата M > 0 (г/моль).');
      return out;
    }
    if (inp.xType === 'p' && !(ps > 0)) {
      out.errors.push('Для давления в Па/кПа укажите давление насыщенного пара pₛ > 0 (в тех же единицах).');
      return out;
    }
    const betLo = isNum(parseNum(inp.betLo)) ? parseNum(inp.betLo) : 0.05;
    const betHi = isNum(parseNum(inp.betHi)) ? parseNum(inp.betHi) : 0.35;

    const pts = [];
    let skippedBad = 0, skippedNonPos = 0, blank = 0;
    (inp.rows || []).forEach((r) => {
      const xs = String(r.x ?? '').trim(), as = String(r.a ?? '').trim();
      if (xs === '' && as === '') { blank++; return; }
      const x0 = parseNum(r.x), a0 = parseNum(r.a);
      if (!isNum(x0) || !isNum(a0)) { skippedBad++; return; }
      if (x0 <= 0 || a0 <= 0) { skippedNonPos++; return; }
      const xm = x0 * xu.f;
      const aMol = au.toMolKg(a0, M);
      let xpps = null;
      if (inp.xType === 'pps') xpps = x0;
      else if (inp.xType === 'p') xpps = x0 / ps;
      pts.push({ x: xm, a: aMol, xRaw: x0, aRaw: a0, xpps });
    });
    if (skippedBad) out.warnings.push(`Пропущено строк с нечисловыми значениями: ${skippedBad}.`);
    if (skippedNonPos) out.warnings.push(`Пропущено строк с нулевыми или отрицательными значениями: ${skippedNonPos} (ln и 1/x для них не определены).`);
    pts.sort((p, q) => p.x - q.x);
    out.points = pts;
    if (pts.length < 3) {
      out.errors.push('Нужно минимум 3 корректные точки изотермы.');
      return out;
    }
    if (inp.xType === 'pps' && pts.some((p) => p.xpps >= 1)) {
      out.warnings.push('Есть точки с p/pₛ ≥ 1: для БЭТ они не используются.');
    }
    out.s0 = s0; out.T = T; out.M = M;
    const Sfn = (Ainf) => (isNum(s0) && s0 > 0 ? surfaceArea(Ainf, s0) : NaN);
    if (!(isNum(s0) && s0 > 0)) out.warnings.push('Площадь молекулы s₀ не задана: удельная поверхность не рассчитана.');

    const xs = pts.map((p) => p.x), as = pts.map((p) => p.a);
    const xmax = Math.max(...xs), amax = Math.max(...as);

    /* ---- Ленгмюр ---- */
    const L = { name: 'Ленгмюр', applicable: true, lin: { ok: false }, nl: { ok: false } };
    {
      const reg = linreg(xs.map((x) => 1 / x), as.map((a) => 1 / a));
      if (!reg.ok) L.lin.reason = reg.reason;
      else {
        const b = reg.intercept, m = reg.slope;
        Object.assign(L.lin, { slope: m, intercept: b, r2: reg.r2, n: reg.n, seSlope: reg.seSlope, seInt: reg.seInt });
        if (!(b > 0) || !(m > 0)) {
          L.lin.reason = 'Отсечка или наклон прямой ≤ 0: A∞ и K получаются неположительными — модель Ленгмюра к этим данным неприменима.';
        } else {
          L.lin.ok = true;
          L.lin.Ainf = 1 / b; L.lin.K = b / m;
          L.lin.S = Sfn(L.lin.Ainf);
          L.lin.r2A = r2Of(as, xs.map((x) => langmuirA([L.lin.Ainf, L.lin.K], x)));
        }
      }
      const start = L.lin.ok ? [L.lin.Ainf, L.lin.K] : [amax * 1.3, 1 / (xs[Math.floor(xs.length / 2)])];
      const fit = fitLM(langmuirA, start.map(Math.log), xs, as);
      if (fit.ok) {
        L.nl = { ok: true, Ainf: fit.p[0], K: fit.p[1], converged: fit.converged };
        L.nl.S = Sfn(L.nl.Ainf);
        L.nl.r2A = r2Of(as, xs.map((x) => langmuirA(fit.p, x)));
      } else L.nl.reason = fit.reason;
      if (L.lin.ok && L.lin.r2 < 0.95) out.warnings.push(`Ленгмюр: R² = ${L.lin.r2.toFixed(3)} < 0,95 — линейность слабая, параметры ненадёжны.`);
    }
    out.langmuir = L;

    /* ---- Фрейндлих ---- */
    const Fr = { name: 'Фрейндлих', applicable: true, lin: { ok: false }, nl: { ok: false } };
    {
      const reg = linreg(xs.map(Math.log), as.map(Math.log));
      if (!reg.ok) Fr.lin.reason = reg.reason;
      else {
        Object.assign(Fr.lin, { slope: reg.slope, intercept: reg.intercept, r2: reg.r2, n: reg.n });
        if (!(reg.slope > 0)) Fr.lin.reason = 'Показатель 1/n ≤ 0: адсорбция не растёт с концентрацией, модель Фрейндлиха неприменима.';
        else {
          Fr.lin.ok = true;
          Fr.lin.KF = Math.exp(reg.intercept); Fr.lin.invN = reg.slope; Fr.lin.n = 1 / reg.slope;
          Fr.lin.r2A = r2Of(as, xs.map((x) => freundlichA([Fr.lin.KF, Fr.lin.invN], x)));
          if (Fr.lin.invN > 1) out.warnings.push('Фрейндлих: 1/n > 1 — для обычной адсорбции ожидается 0 < 1/n < 1.');
        }
      }
      const start = Fr.lin.ok ? [Fr.lin.KF, Fr.lin.invN] : [amax / Math.pow(xmax, 0.5), 0.5];
      const fit = fitLM(freundlichA, start.map(Math.log), xs, as);
      if (fit.ok) {
        Fr.nl = { ok: true, KF: fit.p[0], invN: fit.p[1], n: 1 / fit.p[1], converged: fit.converged };
        Fr.nl.r2A = r2Of(as, xs.map((x) => freundlichA(fit.p, x)));
      } else Fr.nl.reason = fit.reason;
      if (Fr.lin.ok && Fr.lin.r2 < 0.95) out.warnings.push(`Фрейндлих: R² = ${Fr.lin.r2.toFixed(3)} < 0,95.`);
    }
    out.freundlich = Fr;

    /* ---- БЭТ ---- */
    const B = { name: 'БЭТ', applicable: inp.xType !== 'c', lin: { ok: false }, nl: { ok: false }, lo: betLo, hi: betHi };
    if (!B.applicable) {
      B.reason = 'БЭТ определён для относительного давления p/pₛ — выберите ось x «p/pₛ» или «p, Па».';
    } else {
      pts.forEach((p) => { p.inBET = p.xpps !== null && p.xpps > 0 && p.xpps < 1 && p.xpps >= betLo && p.xpps <= betHi; });
      const sel = pts.filter((p) => p.inBET);
      B.nUsed = sel.length;
      if (sel.length < 3) {
        B.reason = `В интервале ${betLo}–${betHi} только ${sel.length} точек (нужно ≥ 3). Расширьте интервал p/pₛ или добавьте измерения.`;
        B.lin.reason = B.reason;
      } else {
        const X = sel.map((p) => p.xpps), Y = sel.map((p) => p.xpps / (p.a * (1 - p.xpps)));
        const reg = linreg(X, Y);
        if (!reg.ok) { B.lin.reason = reg.reason; }
        else {
          const sl = reg.slope, ic = reg.intercept;
          Object.assign(B.lin, { slope: sl, intercept: ic, r2: reg.r2, n: reg.n, seSlope: reg.seSlope, seInt: reg.seInt });
          if (!(ic > 0) || !(sl + ic > 0)) {
            B.lin.reason = 'Отсечка ≤ 0 или (наклон + отсечка) ≤ 0: константы БЭТ не имеют физического смысла (C < 0). Сузьте интервал p/pₛ.';
          } else {
            B.lin.ok = true;
            B.lin.Ainf = 1 / (sl + ic);
            B.lin.C = 1 + sl / ic;
            B.lin.S = Sfn(B.lin.Ainf);
            B.lin.r2A = r2Of(sel.map((p) => p.a), sel.map((p) => betA([B.lin.Ainf, B.lin.C], p.xpps)));
            if (B.lin.C < 2) out.warnings.push(`БЭТ: C = ${B.lin.C.toFixed(1)} < 2 — изотерма типа III, применимость БЭТ сомнительна.`);
            if (B.lin.r2 < 0.99) out.warnings.push(`БЭТ: R² = ${B.lin.r2.toFixed(4)} — для надёжного определения S ожидается R² ≥ 0,99 в интервале 0,05–0,35.`);
          }
        }
        const startB = B.lin.ok ? [B.lin.Ainf, B.lin.C] : [Math.max(...sel.map((p) => p.a)) * 0.8, 50];
        const fit = fitLM(betA, startB.map(Math.log), sel.map((p) => p.xpps), sel.map((p) => p.a));
        if (fit.ok) {
          B.nl = { ok: true, Ainf: fit.p[0], C: fit.p[1], converged: fit.converged };
          B.nl.S = Sfn(B.nl.Ainf);
          B.nl.r2A = r2Of(sel.map((p) => p.a), sel.map((p) => betA(fit.p, p.xpps)));
        } else B.nl.reason = fit.reason;
      }
    }
    out.bet = B;

    /* ---- термодинамические оценки ---- */
    out.thermo = {};
    if (isNum(T) && T > 0) {
      if (inp.xType === 'c' && L.lin.ok) out.thermo.dG = -CONST.R * T * Math.log(L.lin.K) / 1000; // кДж/моль, K в л/моль
      if (B.lin.ok) out.thermo.dq = CONST.R * T * Math.log(B.lin.C) / 1000;                      // кДж/моль
    } else out.warnings.push('Температура T не задана: термодинамические оценки не рассчитаны.');

    out.xmax = xmax; out.amax = amax;
    out.ok = true;
    return out;
  }

  /* ======================================================================
     МОДУЛЬ 2. СЕДИМЕНТАЦИОННЫЙ АНАЛИЗ
     ====================================================================== */
  // решение симметричной ленточной (полуширина 2) системы без выбора главного элемента (матрица SPD)
  function solveBand(A, b, bw) {
    const m = b.length;
    const a = A.map((r) => r.slice()), x = b.slice();
    for (let k = 0; k < m; k++) {
      const piv = a[k][k];
      if (!(Math.abs(piv) > 1e-300)) return null;
      for (let i = k + 1; i <= Math.min(k + bw, m - 1); i++) {
        const f = a[i][k] / piv;
        if (f === 0) continue;
        for (let j = k; j <= Math.min(k + bw, m - 1); j++) a[i][j] -= f * a[k][j];
        x[i] -= f * x[k];
      }
    }
    for (let i = m - 1; i >= 0; i--) {
      let s = x[i];
      for (let j = i + 1; j <= Math.min(i + bw, m - 1); j++) s -= a[i][j] * x[j];
      x[i] = s / a[i][i];
    }
    return x;
  }

  function makeCubic(x, g, M) {
    const n = x.length;
    const seg = (t) => {
      if (t <= x[0]) return 0;
      if (t >= x[n - 1]) return n - 2;
      let lo = 0, hi = n - 1;
      while (hi - lo > 1) { const mid = (lo + hi) >> 1; if (x[mid] <= t) lo = mid; else hi = mid; }
      return lo;
    };
    return {
      eval(t) { const i = seg(t), h = x[i + 1] - x[i], a = (x[i + 1] - t) / h, b = (t - x[i]) / h;
        return a * g[i] + b * g[i + 1] + ((a * a * a - a) * M[i] + (b * b * b - b) * M[i + 1]) * h * h / 6; },
      d1(t) { const i = seg(t), h = x[i + 1] - x[i], a = (x[i + 1] - t) / h, b = (t - x[i]) / h;
        return (g[i + 1] - g[i]) / h + (-(3 * a * a - 1) * M[i] + (3 * b * b - 1) * M[i + 1]) * h / 6; },
      d2(t) { const i = seg(t), h = x[i + 1] - x[i], a = (x[i + 1] - t) / h, b = (t - x[i]) / h;
        return a * M[i] + b * M[i + 1]; }
    };
  }

  /* Естественный кубический сглаживающий сплайн (Рейнш; Green & Silverman):
     минимизирует Σ(yᵢ − f(xᵢ))² + α∫f″² ; α подбирается так, чтобы
     Σ(yᵢ − f(xᵢ))² = s  (как параметр s у scipy.interpolate.UnivariateSpline).
     s = 0 → интерполяционный естественный сплайн. */
  function smoothingSpline(xIn, yIn, s, alphaFixed) {
    const n = xIn.length;
    if (n < 3) return null;
    const x0 = xIn[0], T = xIn[n - 1] - xIn[0];
    const Y = Math.max(...yIn.map(Math.abs)) || 1;
    const x = xIn.map((v) => (v - x0) / T), y = yIn.map((v) => v / Y);
    const sS = s / (Y * Y);
    const m = n - 2;
    const h = []; for (let i = 0; i < n - 1; i++) h.push(x[i + 1] - x[i]);
    const q0 = [], q1 = [], q2 = [];
    for (let j = 0; j < m; j++) { q0.push(1 / h[j]); q1.push(-1 / h[j] - 1 / h[j + 1]); q2.push(1 / h[j + 1]); }
    const Qty = []; for (let j = 0; j < m; j++) Qty.push(q0[j] * y[j] + q1[j] * y[j + 1] + q2[j] * y[j + 2]);
    // R и QᵀQ (пятидиагональные)
    const Rm = Array.from({ length: m }, () => new Array(m).fill(0));
    const QQ = Array.from({ length: m }, () => new Array(m).fill(0));
    for (let j = 0; j < m; j++) {
      Rm[j][j] = (h[j] + h[j + 1]) / 3;
      if (j + 1 < m) { Rm[j][j + 1] = Rm[j + 1][j] = h[j + 1] / 6; }
      QQ[j][j] = q0[j] * q0[j] + q1[j] * q1[j] + q2[j] * q2[j];
      if (j + 1 < m) { const v = q1[j] * q0[j + 1] + q2[j] * q1[j + 1]; QQ[j][j + 1] = QQ[j + 1][j] = v; }
      if (j + 2 < m) { const v = q2[j] * q0[j + 2]; QQ[j][j + 2] = QQ[j + 2][j] = v; }
    }
    const solveFor = (alpha) => {
      const A = Rm.map((row, i) => row.map((v, j) => v + alpha * QQ[i][j]));
      const gam = solveBand(A, Qty, 2);
      if (!gam) return null;
      const g = y.slice();
      let rss = 0;
      for (let i = 0; i < n; i++) {
        let qg = 0;
        for (let j = Math.max(0, i - 2); j <= Math.min(m - 1, i); j++) {
          const val = i === j ? q0[j] : i === j + 1 ? q1[j] : q2[j];
          qg += val * gam[j];
        }
        g[i] = y[i] - alpha * qg;
        rss += (y[i] - g[i]) ** 2;
      }
      return { gam, g, rss };
    };
    let alpha, sol;
    if (alphaFixed !== undefined) { alpha = alphaFixed; sol = solveFor(alpha); }
    else if (!(sS > 1e-14)) { alpha = 0; sol = solveFor(0); }
    else {
      let lo = Math.log(1e-14), hi = Math.log(1e12);
      const top = solveFor(Math.exp(hi));
      if (top && top.rss <= sS) { alpha = Math.exp(hi); sol = top; }
      else {
        for (let it = 0; it < 90; it++) {
          const mid = 0.5 * (lo + hi);
          const r = solveFor(Math.exp(mid));
          if (!r) { hi = mid; continue; }
          if (r.rss > sS) hi = mid; else lo = mid;
        }
        alpha = Math.exp(0.5 * (lo + hi)); sol = solveFor(alpha);
      }
    }
    if (!sol) return null;
    const Mv = new Array(n).fill(0); for (let j = 0; j < m; j++) Mv[j + 1] = sol.gam[j];
    const cub = makeCubic(x, sol.g, Mv);
    const tt = (t) => (t - x0) / T;
    return {
      alpha, rss: sol.rss * Y * Y,
      eval: (t) => Y * cub.eval(tt(t)),
      d1: (t) => (Y / T) * cub.d1(tt(t)),
      d2: (t) => (Y / (T * T)) * cub.d2(tt(t)),
      nodes: xIn.slice(), fitted: sol.g.map((v) => v * Y)
    };
  }

  function stokesRadius(tau, eta, h, drho, g) { // м
    return Math.sqrt((9 * eta * h) / (2 * drho * g * tau));
  }

  function crossing(taus, qs, target) { // τ, при котором Q впервые достигает target
    for (let i = 1; i < qs.length; i++) {
      if (qs[i - 1] < target && qs[i] >= target) {
        const f = (target - qs[i - 1]) / (qs[i] - qs[i - 1]);
        return taus[i - 1] + f * (taus[i] - taus[i - 1]);
      }
    }
    return NaN;
  }

  function sedimentation(inp) {
    const out = { ok: false, warnings: [], errors: [] };
    const tf = inp.tauUnit === 'min' ? 60 : 1;
    const h = parseNum(inp.h), rho = parseNum(inp.rho), rho0 = parseNum(inp.rho0);
    const eta = parseNum(inp.eta), g = isNum(parseNum(inp.g)) ? parseNum(inp.g) : 9.81;
    const m0 = isNum(parseNum(inp.m0)) ? parseNum(inp.m0) : 0;
    const delta = isNum(parseNum(inp.smooth)) ? Math.max(0, parseNum(inp.smooth)) : 1; // % от m_max
    if (!(h > 0)) out.errors.push('Высота столба суспензии h должна быть > 0.');
    if (!(eta > 0)) out.errors.push('Вязкость среды η должна быть > 0.');
    if (!(g > 0)) out.errors.push('Ускорение свободного падения g должно быть > 0.');
    if (!(rho > 0) || !(rho0 > 0)) out.errors.push('Плотности ρ и ρ₀ должны быть > 0.');
    else if (!(rho > rho0)) out.errors.push('ρ ≤ ρ₀: частицы не оседают (формула Стокса даёт r² ≤ 0).');
    if (out.errors.length) return out;
    const drho = rho - rho0;

    let rows = [], bad = 0, neg = 0;
    (inp.rows || []).forEach((r) => {
      const ts = String(r.t ?? '').trim(), ms = String(r.m ?? '').trim();
      if (ts === '' && ms === '') return;
      const t = parseNum(r.t), mv = parseNum(r.m);
      if (!isNum(t) || !isNum(mv)) { bad++; return; }
      if (t < 0) { bad++; return; }
      const mSigma = mv - m0;
      if (mSigma < 0) { neg++; return; }
      rows.push({ tau: t * tf, m: mSigma });
    });
    if (bad) out.warnings.push(`Пропущено строк с нечисловыми или отрицательными значениями времени: ${bad}.`);
    if (neg) out.warnings.push(`Пропущено строк, где масса после вычитания m₀ отрицательна: ${neg}.`);
    rows.sort((a, b) => a.tau - b.tau);
    // слияние одинаковых моментов времени
    const merged = [];
    rows.forEach((r) => {
      const last = merged[merged.length - 1];
      if (last && Math.abs(last.tau - r.tau) < 1e-9) { last.m = (last.m * last.k + r.m) / (last.k + 1); last.k++; }
      else merged.push({ tau: r.tau, m: r.m, k: 1 });
    });
    if (merged.some((r) => r.k > 1)) out.warnings.push('Для повторных измерений в один момент времени взято среднее значение массы.');
    let data = merged.filter((r) => r.tau > 0);
    if (data.length < 4) { out.errors.push('Нужно минимум 4 точки с τ > 0 (кубический сплайн и касательные).'); return out; }
    const zeroRow = merged.find((r) => r.tau === 0);
    const useLog = inp.axis !== 'lin';                       // сглаживание по ln τ (по умолчанию) или по τ
    const origin = !useLog && (inp.addOrigin !== false || zeroRow) ? { tau: 0, m: zeroRow ? zeroRow.m : 0 } : null;
    const nodes = origin ? [origin, ...data] : data.slice();

    let mmax = Math.max(...data.map((r) => r.m));
    const minf = parseNum(inp.minf);
    if (isNum(minf) && minf > 0) mmax = minf; // m_max задана вручную (масса осадка, без m₀)
    if (!(mmax > 0)) { out.errors.push('Максимальная масса осадка m_max должна быть > 0.'); return out; }

    // контроль монотонности и плато
    for (let i = 1; i < data.length; i++) {
      if (data[i].m < data[i - 1].m - 0.03 * mmax) { out.warnings.push('Масса осадка уменьшается со временем — проверьте данные (должна расти до плато).'); break; }
    }
    const kk = data.length;
    const endSlope = (data[kk - 1].m - data[kk - 2].m) / (data[kk - 1].tau - data[kk - 2].tau);
    if (endSlope * data[kk - 1].tau / mmax > 0.05) {
      out.warnings.push('Кривая седиментации не вышла на плато: m_max занижена, доли Q и радиусы будут смещены. Продолжите измерения или задайте m_max вручную.');
    }

    const nx = nodes.map((r) => (useLog ? Math.log(r.tau) : r.tau)), ny = nodes.map((r) => r.m);
    const sTarget = nodes.length * Math.pow((delta / 100) * mmax, 2);
    const sp = smoothingSpline(nx, ny, sTarget);
    if (!sp) { out.errors.push('Не удалось построить сплайн (вырожденные данные).'); return out; }
    // m(τ), τ·dm/dτ и τ²·d²m/dτ² независимо от выбранной оси сглаживания
    const mAt = (t) => sp.eval(useLog ? Math.log(t) : t);
    const tm1At = (t) => (useLog ? sp.d1(Math.log(t)) : t * sp.d1(t));
    const t2m2At = (t) => (useLog ? sp.d2(Math.log(t)) - sp.d1(Math.log(t)) : t * t * sp.d2(t));
    out.spline = sp; out.mmax = mmax; out.nodes = nodes; out.data = data; out.delta = delta; out.useLog = useLog;
    out.rss = sp.rss; out.mAt = mAt;

    // ---- плотная сетка для интегральной и дифференциальной кривых ----
    const tMin = data[0].tau, tMax = data[kk - 1].tau, N = 320;
    const grid = { tau: [], m: [], slope: [], Q: [], r: [], F: [] };
    for (let i = 0; i < N; i++) {
      const t = tMin * Math.pow(tMax / tMin, i / (N - 1));
      const mv = mAt(t), tm1 = tm1At(t), t2m2 = t2m2At(t);
      const Q = ((mv - tm1) / mmax) * 100;
      const rm = stokesRadius(t, eta, h, drho, g);
      const Fv = Math.max(0, (-2 * t2m2) / (rm * mmax)) * 100 * 1e-6; // %/мкм
      grid.tau.push(t); grid.m.push(mv); grid.slope.push(tm1 / t); grid.Q.push(Q); grid.r.push(rm * 1e6); grid.F.push(Fv);
    }
    out.grid = grid;
    let iMode = 0;
    for (let i = 1; i < N; i++) if (grid.F[i] > grid.F[iMode]) iMode = i;
    out.mode = { r: grid.r[iMode], F: grid.F[iMode], tau: grid.tau[iMode], edge: iMode < 8 || iMode > N - 9 };
    if (out.mode.edge) out.warnings.push('Максимум дифференциальной кривой лежит на краю диапазона измерений: распределение может быть шире окна наблюдения.');

    const rAt = (q) => { const t = crossing(grid.tau, grid.Q, q); return isNaN(t) ? NaN : stokesRadius(t, eta, h, drho, g) * 1e6; };
    out.r50 = rAt(50); out.r10 = rAt(10); out.r90 = rAt(90);   // r при Q = 10, 50, 90 % (Q — доля частиц крупнее r)
    out.width = isNum(out.r10) && isNum(out.r90) && out.r90 > 0 ? out.r10 / out.r90 : NaN;

    // ---- таблица «метода касательных» (табл. 2.4 учебника) ----
    const pts = data.map((d) => {
      const mv = mAt(d.tau), d1 = tm1At(d.tau) / d.tau;
      const Qabs = mv - d.tau * d1;
      return { tau: d.tau, mExp: d.m, mSm: mv, slope: d1, Qabs, Q: (Qabs / mmax) * 100, r: stokesRadius(d.tau, eta, h, drho, g) * 1e6 };
    });
    const tab = [];
    for (let i = 0; i < pts.length - 1; i++) {
      const a = pts[i], b = pts[i + 1];
      const dr = a.r - b.r, dQ = b.Q - a.Q;
      tab.push({ tau: a.tau, r: a.r, Q: a.Q, dr, dQ, F: dr > 0 ? Math.max(0, dQ) / dr : NaN, rcp: (a.r + b.r) / 2 });
    }
    out.points = pts; out.table = tab;

    // ---- метод Н. Н. Цюрупы (аналитический) ----
    const ts = data.map((d) => d.tau), Qs = data.map((d) => (d.m / mmax) * 100);
    const idxPos = ts.map((_, i) => i).filter((i) => Qs[i] > 0);
    const reg = linreg(idxPos.map((i) => ts[i]), idxPos.map((i) => ts[i] / Qs[i])); // τ/Q = τ₀/Q_m + τ/Q_m
    const ty = { ok: false };
    if (reg.ok && reg.slope > 0 && reg.intercept > 0) {
      const Qm = 1 / reg.slope, tau0 = reg.intercept * Qm;
      const r0 = stokesRadius(tau0, eta, h, drho, g) * 1e6;
      ty.ok = true; ty.Qm = Qm; ty.tau0 = tau0; ty.r0 = r0; ty.r2 = reg.r2;
      ty.rn = r0 / Math.sqrt(5);                      // r_н = r₀/2,236 (в учебнике 2,24)
      ty.rmax = 3 * r0;
      ty.rmin = Qm > 100 ? r0 * Math.sqrt(Math.sqrt(Qm / 100) - 1) : NaN;
      ty.SP = isNum(ty.rmin) ? ty.rmax / ty.rmin : NaN;
      ty.Qfn = (r) => { const a = (r0 * r0) / (r0 * r0 + r * r); return Qm * a * a; };
      ty.Ffn = (r) => { const a = (r0 * r0) / (r0 * r0 + r * r); return (4 * Qm * Math.pow(a, 2.5) * Math.sqrt(1 - a)) / r0; };
    } else {
      ty.reason = reg.ok ? 'Прямая τ/Q = f(τ) имеет неположительный наклон или отсечку: метод Цюрупы неприменим к этим данным.' : reg.reason;
    }
    out.tsyurupa = ty; out.tsyurupaReg = reg;
    if (ty.ok) {
      out.modeAgree = Math.abs(out.mode.r - ty.rn) / ((out.mode.r + ty.rn) / 2);
      if (out.modeAgree > 0.25) {
        out.warnings.push(`Модальный радиус по сплайну (${out.mode.r.toFixed(2)} мкм) и по Цюрупе (${ty.rn.toFixed(2)} мкм) расходятся более чем на 25 %: `
          + 'двойное дифференцирование шумных данных на поздних временах ненадёжно. Увеличьте сглаживание, добавьте точек или ориентируйтесь на метод Цюрупы.');
      }
    }

    // ---- проверки применимости закона Стокса ----
    const rLarge = stokesRadius(tMin, eta, h, drho, g);
    const uLarge = h / tMin;
    out.Re = (2 * rLarge * uLarge * rho0) / eta;
    if (out.Re > 0.2) out.warnings.push(`Число Рейнольдса для самых крупных частиц Re ≈ ${out.Re.toFixed(2)} > 0,2: режим не ламинарный, закон Стокса завышает радиус.`);
    if (out.mode.r < 0.5 || out.mode.r > 50) out.warnings.push('Модальный радиус вне диапазона 0,5–50 мкм (d ≈ 1–100 мкм): метод седиментации в гравитационном поле здесь неточен.');
    out.rRange = [rLarge * 1e6, stokesRadius(tMax, eta, h, drho, g) * 1e6];
    out.tangentAt = (tau) => {
      const mv = mAt(tau), d1 = tm1At(tau) / tau;
      return { tau, m: mv, slope: d1, intercept: mv - tau * d1, Q: ((mv - tau * d1) / mmax) * 100,
               r: stokesRadius(tau, eta, h, drho, g) * 1e6 };
    };
    out.tMin = tMin; out.tMax = tMax; out.tf = tf;
    out.ok = true;
    return out;
  }

  /* ======================================================================
     МОДУЛЬ 3. ЭЛЕКТРОКИНЕТИЧЕСКИЙ ПОТЕНЦИАЛ
     ====================================================================== */
  // приближение Ошимы к функции Генри f(κa): 1 (κa→0, Хюккель) … 1,5 (κa→∞, Смолуховский)
  function henryOhshima(ka) {
    return 1 + 1 / (2 * Math.pow(1 + 2.5 / (ka * (1 + 2 * Math.exp(-ka))), 3));
  }

  function debye(epsR, T, Imol) { // I в моль/л (ионная сила) → λ, м
    const I = Imol * 1000; // моль/м³
    return Math.sqrt((epsR * CONST.EPS0 * CONST.R * T) / (2 * 96485.33212 ** 2 * I));
  }

  function stabilityOf(zetaMV) {
    const a = Math.abs(zetaMV);
    if (a < 5) return { level: 'bad', label: 'Быстрая коагуляция', text: '|ζ| < 5 мВ: электростатического барьера практически нет, золь коагулирует.' };
    if (a < 30) return { level: 'bad', label: 'Неустойчивая система', text: '|ζ| < 30 мВ: барьер мал, начинается агрегация; система агрегативно неустойчива.' };
    if (a < 40) return { level: 'warn', label: 'Умеренная устойчивость', text: '30 ≤ |ζ| < 40 мВ: порог пройден, но запас по устойчивости небольшой.' };
    if (a < 60) return { level: 'ok', label: 'Хорошая устойчивость', text: '40 ≤ |ζ| < 60 мВ: заметный электростатический барьер.' };
    return { level: 'good', label: 'Отличная устойчивость', text: '|ζ| ≥ 60 мВ: высокий барьер отталкивания.' };
  }

  function electrophoresis(inp) {
    const out = { ok: false, warnings: [], errors: [], method: 'electrophoresis' };
    const eps = parseNum(inp.eps), eta = parseNum(inp.eta);
    if (!(eps > 0)) out.errors.push('Диэлектрическая проницаемость ε должна быть > 0.');
    if (!(eta > 0)) out.errors.push('Вязкость η должна быть > 0.');
    let u, E, a, tau, U, L;
    if (inp.input === 'velocity') {
      u = parseNum(inp.u) * (parseNum(inp.uf) || 1);
      E = parseNum(inp.E);
      if (!(u > 0)) out.errors.push('Скорость u должна быть > 0 (направление задаётся отдельно).');
      if (!(E > 0)) out.errors.push('Напряжённость поля E должна быть > 0.');
    } else {
      a = parseNum(inp.a) * (parseNum(inp.af) || 1e-3);
      tau = parseNum(inp.tau) * (parseNum(inp.tf) || 60);
      U = parseNum(inp.U); L = parseNum(inp.L);
      if (!(a > 0)) out.errors.push('Смещение границы a должно быть > 0.');
      if (!(tau > 0)) out.errors.push('Время τ должно быть > 0 (деление на ноль).');
      if (!(U > 0)) out.errors.push('Напряжение U должно быть > 0.');
      if (!(L > 0)) out.errors.push('Расстояние между электродами L должно быть > 0.');
      if (!out.errors.length) { u = a / tau; E = U / L; }
    }
    if (out.errors.length) return out;
    const sgn = inp.dir === 'anode' ? -1 : 1; // к катоду → частицы положительны
    const Ue = (sgn * u) / E;
    // поправка k: 1 (Смолуховский) … 3/2 (Хюккель); Генри: k = 1,5 / f(κa)
    let k = 1, kText = 'Смолуховский, k = 1', lambda = NaN, ka = NaN, f = NaN;
    const Tk = parseNum(inp.T), Imol = parseNum(inp.I), rad = parseNum(inp.rad) * 1e-9;
    if (isNum(Imol) && Imol > 0 && isNum(Tk) && Tk > 0 && eps > 0) {
      lambda = debye(eps, Tk, Imol);
      if (isNum(rad) && rad > 0) ka = rad / lambda;
    }
    if (inp.corr === 'huckel') { k = 1.5; kText = 'Хюккель, k = 3/2'; }
    else if (inp.corr === 'henry') {
      if (isNum(ka)) { f = henryOhshima(ka); k = 1.5 / f; kText = `Генри (Ошима), f(κa) = ${f.toFixed(3)}, k = ${k.toFixed(3)}`; }
      else { out.warnings.push('Для поправки Генри укажите радиус частиц, ионную силу и температуру. Пока использована поправка Смолуховского (k = 1).'); }
    }
    if (isNum(ka)) {
      if ((inp.corr || 'smol') === 'smol' && ka < 10) out.warnings.push(`κa = ${ka.toFixed(1)}: двойной слой не тонкий, формула Смолуховского занижает |ζ|; рассмотрите поправку Хюккеля или Генри.`);
      if (inp.corr === 'huckel' && ka > 10) out.warnings.push(`κa = ${ka.toFixed(0)} ≫ 1: поправка Хюккеля (k = 3/2) для тонкого двойного слоя завышает |ζ|; используйте Смолуховского.`);
    }
    const zeta = (k * eta * Ue) / (eps * CONST.EPS0); // В
    Object.assign(out, { ok: true, u, E, Ue, k, kText, zeta, zetaMV: zeta * 1000, lambda, ka, f, sgn,
      stability: stabilityOf(zeta * 1000) });
    return out;
  }

  function electroosmosis(inp) {
    const out = { ok: false, warnings: [], errors: [], method: 'electroosmosis' };
    const eps = parseNum(inp.eps), eta = parseNum(inp.eta);
    if (!(eps > 0)) out.errors.push('Диэлектрическая проницаемость ε должна быть > 0.');
    if (!(eta > 0)) out.errors.push('Вязкость η должна быть > 0.');
    let zetaAbs;
    const info = {};
    if (inp.eoForm === 'linear') {
      const u = parseNum(inp.u) * (parseNum(inp.uf) || 1), E = parseNum(inp.E);
      if (!(u > 0)) out.errors.push('Линейная скорость жидкости u должна быть > 0.');
      if (!(E > 0)) out.errors.push('Напряжённость поля E должна быть > 0.');
      if (!out.errors.length) { zetaAbs = (eta * u) / (eps * CONST.EPS0 * E); info.u = u; info.E = E; }
    } else {
      let v;
      if (inp.vMode === 'volume') {
        const V = parseNum(inp.V) * (parseNum(inp.Vf) || 1e-6), tau = parseNum(inp.tau);
        if (!(V > 0)) out.errors.push('Объём перенесённой жидкости V должен быть > 0.');
        if (!(tau > 0)) out.errors.push('Время τ должно быть > 0 (деление на ноль).');
        v = V / tau;
      } else {
        v = parseNum(inp.v) * (parseNum(inp.vf) || 1e-6);
        if (!(v > 0)) out.errors.push('Объёмная скорость v должна быть > 0.');
      }
      const I = parseNum(inp.I) * (parseNum(inp.If) || 1e-3);
      if (!(I > 0)) out.errors.push('Сила тока I должна быть > 0 (деление на ноль).');
      let kappa = parseNum(inp.kappa);
      if (!(kappa > 0)) out.errors.push('Удельная электропроводность κ должна быть > 0.');
      if (inp.surf) {
        const R1 = parseNum(inp.R1), R2 = parseNum(inp.R2), kst = parseNum(inp.kst);
        if (!(R1 > 0) || !(R2 > 0) || !(kst > 0)) out.errors.push('Для поправки на поверхностную проводимость нужны R_x, R_KCl и κ_KCl > 0.');
        else { kappa = (kst * R2) / R1; info.kappaEff = kappa; }
      }
      if (!out.errors.length) { zetaAbs = (eta * v * kappa) / (eps * CONST.EPS0 * I); info.v = v; info.I = I; info.kappa = kappa; }
    }
    if (out.errors.length) return out;
    // жидкость движется к катоду → противоионы положительны → поверхность отрицательна → ζ < 0
    const sgn = inp.dir === 'anode' ? 1 : -1;
    const zeta = sgn * zetaAbs;
    Object.assign(out, { ok: true, zeta, zetaMV: zeta * 1000, sgn, info, k: 1, kText: 'Гельмгольц — Смолуховский',
      stability: stabilityOf(zeta * 1000) });
    return out;
  }

  return {
    CONST, A_UNITS, X_UNITS, parseNum, isNum, linreg, r2Of, fitLM, solveLin,
    langmuirA, betA, freundlichA, surfaceArea, adsorption,
    smoothingSpline, stokesRadius, sedimentation,
    henryOhshima, debye, stabilityOf, electrophoresis, electroosmosis
  };
});

