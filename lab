  /* ---------- таблицы ввода ---------- */
  function makeTable(id, mod, keys, labels, onChange) {
    const tb = $(`#${id} tbody`);
    const rows = () => S[mod].rows;
    const blank = () => { const o = {}; keys.forEach((k) => { o[k] = ''; }); return o; };
    function render() {
      if (!rows().length) rows().push(blank());
      tb.innerHTML = rows().map((r, i) => `<tr><td class="n">${i + 1}</td>` +
        keys.map((k, j) => `<td><input type="text" inputmode="decimal" autocomplete="off" autocorrect="off" enterkeyhint="next" data-i="${i}" data-k="${k}" aria-label="${esc(labels[j])}, строка ${i + 1}" value="${esc(r[k])}"></td>`).join('') +
        `<td class="x"><button type="button" class="del" data-del="${i}" aria-label="Удалить строку ${i + 1}">×</button></td></tr>`).join('');
    }
    tb.addEventListener('input', (e) => {
      const t = e.target; if (t.dataset.k === undefined) return;
      rows()[+t.dataset.i][t.dataset.k] = t.value; onChange();
    });
    tb.addEventListener('click', (e) => {
      const b = e.target.closest('[data-del]'); if (!b) return;
      rows().splice(+b.dataset.del, 1); render(); onChange();
    });
    tb.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' || e.target.dataset.k === undefined) return;
      e.preventDefault();
      const i = +e.target.dataset.i, k = e.target.dataset.k;
      if (i === rows().length - 1) { rows().push(blank()); render(); onChange(); }
      const nx = tb.querySelector(`input[data-i="${i + 1}"][data-k="${k}"]`); if (nx) nx.focus();
    });
    return {
      render,
      add() { rows().push(blank()); render(); onChange(); const l = tb.querySelector(`input[data-i="${rows().length - 1}"][data-k="${keys[0]}"]`); if (l) l.focus(); },
      clear() { S[mod].rows = [blank()]; render(); onChange(); },
      setRows(rs) { S[mod].rows = rs.length ? rs : [blank()]; render(); onChange(); }
    };
  }

  /* разбор вставленного текста / CSV: две первых числовых колонки */
  function parsePairs(text) {
    const out = [];
    String(text).split(/\r?\n/).forEach((line) => {
      line = line.trim(); if (!line) return;
      let parts;
      if (/[;\t]/.test(line)) parts = line.split(/[;\t]+/);
      else if (/\s/.test(line)) parts = line.split(/\s+/);
      else if (line.indexOf(',') >= 0) parts = line.split(',');
      else return;
      parts = parts.map((p) => p.trim()).filter((p) => p !== '');
      if (parts.length < 2) return;
      if (!isNum(num(parts[0])) || !isNum(num(parts[1]))) return; // заголовки пропускаем
      out.push([parts[0].replace('.', ','), parts[1].replace('.', ',')]);
    });
    return out;
  }
  function wireImport(prefix, tbl, keys) {
    const apply = (text) => {
      const pairs = parsePairs(text);
      if (!pairs.length) { toast('Не нашёл строк с двумя числами'); return; }
      tbl.setRows(pairs.map((p) => ({ [keys[0]]: p[0], [keys[1]]: p[1] })));
      toast(`Загружено строк: ${pairs.length}`);
    };
    $(`#${prefix}-apply`).addEventListener('click', () => apply($(`#${prefix}-paste`).value));
    $(`#${prefix}-file`).addEventListener('change', (e) => {
      const f = e.target.files && e.target.files[0]; if (!f) return;
      const rd = new FileReader();
      rd.onload = () => { $(`#${prefix}-paste`).value = String(rd.result); apply(String(rd.result)); };
      rd.onerror = () => toast('Файл не прочитался');
      rd.readAsText(f); e.target.value = '';
    });
  }

  /* ==========================================================
     МОДУЛЬ 1. АДСОРБЦИЯ
     ========================================================== */
  let adsRes = null;
  const xLab = { c: ['c, моль/л', '1/c, л/моль', 'ln c'], pps: ['p/pₛ', '1/(p/pₛ)', 'ln(p/pₛ)'], p: ['p, Па', '1/p, 1/Па', 'ln p'] };
  const kUnit = { c: 'л/моль', pps: '', p: '1/Па' };

  function pick(model, method) {
    if (!model) return null;
    if (model[method] && model[method].ok) return { f: model[method], m: method };
    const other = method === 'lin' ? 'nl' : 'lin';
    return model[other] && model[other].ok ? { f: model[other], m: other, fallback: true } : null;
  }

  function renderAds() {
    const a = S.ads;
    const r = LC.adsorption({ xType: a.xType, xUnit: a.xUnit, aUnit: a.aUnit, M: a.M, s0: a.s0, T: a.T, ps: a.ps, betLo: a.blo, betHi: a.bhi, rows: a.rows.map((q) => ({ x: q.x, a: q.a })) });
    adsRes = r;
    const infos = [];
    if (!r.ok) {
      $('#ads-msgs').innerHTML = msgHTML(r.errors, r.warnings);
      $('#ads-kpis').innerHTML = ''; $('#ads-rt').innerHTML = ''; $('#ads-thermo').textContent = '';
      CH.draw($('#ads-chart'), { height: 280, series: [], xlabel: '', ylabel: '' }); $('#ads-chart-note').textContent = 'Введите данные изотермы.';
      return;
    }
    const mth = a.method;
    const Lp = pick(r.langmuir, mth), Bp = r.bet.applicable ? pick(r.bet, mth) : null, Fp = pick(r.freundlich, mth);
    [['Ленгмюр', r.langmuir, Lp], ['БЭТ', r.bet, Bp], ['Фрейндлих', r.freundlich, Fp]].forEach(([n, mdl, p]) => {
      if (!p) {
        const why = (mdl.applicable === false ? mdl.reason : (mdl[mth] && mdl[mth].reason) || (mdl.lin && mdl.lin.reason) || (mdl.nl && mdl.nl.reason) || mdl.reason || 'не удалось подобрать параметры');
        infos.push(`<b>${n}:</b> ${why}`);
      } else if (p.fallback) infos.push(`<b>${n}:</b> выбранный метод не сошёлся, показан ${p.m === 'lin' ? 'линейный' : 'нелинейный'}.`);
    });
    $('#ads-msgs').innerHTML = msgHTML([], r.warnings, infos);

    // сводная таблица: колонки — модели
    const cell = (p, f) => (p ? f(p.f, p.m) : '<span class="muted">—</span>');
    const kU = kUnit[a.xType];
    const rowsH = [
      ['A∞, моль/кг', [Lp, Bp, null], (f) => fmt(f.Ainf), true],
      ['Константа', [Lp, Bp, Fp], null],
      ['1/n', [null, null, Fp], (f) => fmt(f.invN)],
      ['S<sub>уд</sub>, м²/г', [Lp, Bp, null], (f) => fmt(f.S, 4)],
      ['R², анаморфоза', [Lp, Bp, Fp], (f, m) => (m === 'lin' ? fix(f.r2, 4) : '<span class="muted">—</span>')],
      ['R², по A(x)', [Lp, Bp, Fp], (f) => fix(f.r2A, 4)]
    ];
    const constTxt = [
      (f) => `K = ${fmt(f.K, 3)}`,
      (f) => `C = ${fmt(f.C, 3)}`,
      (f) => `K<sub>F</sub> = ${fmt(f.KF, 3)}`
    ];
    let html = '<thead><tr><th></th><th>Ленгмюр</th><th>БЭТ</th><th>Фрейндлих</th></tr></thead><tbody>';
    rowsH.forEach(([lab, ps, f]) => {
      html += `<tr><th scope="row">${lab}</th>` + ps.map((p, j) => {
        if (!p) return '<td><span class="muted">—</span></td>';
        if (lab === 'Константа') return `<td>${constTxt[j](p.f)}</td>`;
        return `<td>${f(p.f, p.m)}</td>`;
      }).join('') + '</tr>';
    });
    html += `<tr><th scope="row">Точек в расчёте</th><td>${r.points.length}</td><td>${r.bet.applicable && r.bet.nUsed != null ? r.bet.nUsed : '—'}</td><td>${r.points.length}</td></tr></tbody>`;
    $('#ads-rt').innerHTML = html;

    // ключевые числа
    const prim = Bp ? { n: 'БЭТ', p: Bp } : Lp ? { n: 'Ленгмюр', p: Lp } : null;
    let k = '';
    if (prim) {
      k += kpi(`S<sub>уд</sub> (${prim.n})`, fmt(prim.p.f.S, 4), 'м²/г', isNum(prim.p.f.S) ? '' : 'задайте s₀', true);
      k += kpi('A∞', fmt(prim.p.f.Ainf, 4), 'моль/кг', `ёмкость монослоя, ${prim.n}`);
      k += prim.n === 'БЭТ' ? kpi('C', fmt(prim.p.f.C, 4), '', 'константа БЭТ') : kpi('K', fmt(prim.p.f.K, 4), kU, 'константа Ленгмюра');
    } else if (Fp) {
      k += kpi('1/n', fmt(Fp.f.invN), '', 'Фрейндлих', true) + kpi('K<sub>F</sub>', fmt(Fp.f.KF), '');
    }
    $('#ads-kpis').innerHTML = k;

    const th = [];
    if (kU) th.push(`K в ${kU}; A — в моль/кг.`);
    if (isNum(r.thermo.dG)) th.push(`ΔG° = −RT ln K = ${fix(r.thermo.dG, 1)} кДж/моль (K в л/моль)`);
    if (isNum(r.thermo.dq)) th.push(`q₁ − q<sub>L</sub> ≈ RT ln C = ${fix(r.thermo.dq, 1)} кДж/моль`);
    $('#ads-thermo').innerHTML = th.join('<br>');
    drawAds(r, { Lp, Bp, Fp });
  }

  function drawAds(r, P) {
    const a = S.ads, host = $('#ads-chart'), note = $('#ads-chart-note');
    const L = xLab[a.xType];
    const pts = r.points, xs = pts.map((p) => p.x), as = pts.map((p) => p.a);
    const ink = (name) => name; // имена цветов из CSS
    const tipXY = (xn, yn, i) => `<b>${xn}</b> = ${fmt(xs[i])}<br>${yn} = ${fmt(as[i])} моль/кг`;
    if (a.chart === 'iso') {
      let xm = Math.max(...xs) * 1.04;
      const ratio = a.xType === 'c' ? NaN : pts[0].xpps / pts[0].x; // p/pₛ = ratio·x
      if (a.xType === 'pps') xm = Math.min(xm, 0.999);
      const N = 140, xg = []; for (let i = 0; i <= N; i++) xg.push((xm * i) / N);
      const S_ = [];
      if (P.Lp) S_.push({ kind: 'line', x: xg, y: xg.map((x) => LC.langmuirA([P.Lp.f.Ainf, P.Lp.f.K], x)), color: 'c1', name: 'Ленгмюр' });
      if (P.Fp) S_.push({ kind: 'line', x: xg, y: xg.map((x) => LC.freundlichA([P.Fp.f.KF, P.Fp.f.invN], x)), color: 'c2', name: 'Фрейндлих' });
      if (P.Bp && isNum(ratio)) { const xb = xg.filter((x) => x * ratio < 0.95); S_.push({ kind: 'line', x: xb, y: xb.map((x) => LC.betA([P.Bp.f.Ainf, P.Bp.f.C], x * ratio)), color: 'c3', name: 'БЭТ' }); }
      S_.push({ kind: 'points', x: xs, y: as, color: ink('ink'), name: 'Эксперимент', r: 4.6, tip: (i) => tipXY(L[0].split(',')[0], 'A', i) });
      CH.draw(host, { height: 300, xlabel: L[0], ylabel: 'A, моль/кг', xzero: true, yzero: true, series: S_, title: 'Изотерма адсорбции' });
      note.textContent = 'Кривые построены по найденным параметрам. Модель БЭТ рассчитана только по точкам из выбранного интервала p/pₛ, вне него она показана для сравнения.';
    } else if (a.chart === 'lang') {
      const X = xs.map((x) => 1 / x), Y = as.map((v) => 1 / v), S_ = [];
      if (P.Lp) {
        const b0 = 1 / P.Lp.f.Ainf, sl = 1 / (P.Lp.f.Ainf * P.Lp.f.K), xe = Math.max(...X) * 1.04;
        S_.push({ kind: 'line', x: [0, xe], y: [b0, b0 + sl * xe], color: 'c1', name: `Прямая: R² = ${P.Lp.m === 'lin' ? fix(P.Lp.f.r2, 4) : '—'}`, width: 2.4 });
        S_.push({ kind: 'points', x: [0], y: [b0], color: 'c1', hollow: true, r: 4.5, name: '1/A∞ (отсечка)', tip: () => `Отсечка 1/A∞ = ${fmt(b0)}<br>A∞ = ${fmt(P.Lp.f.Ainf)} моль/кг` });
      }
      S_.push({ kind: 'points', x: X, y: Y, color: 'ink', name: 'Эксперимент', r: 4.6, tip: (i) => `<b>${L[1].split(',')[0]}</b> = ${fmt(X[i])}<br>1/A = ${fmt(Y[i])} кг/моль` });
      CH.draw(host, { height: 300, xlabel: L[1], ylabel: '1/A, кг/моль', xzero: true, yzero: true, series: S_ });
      note.textContent = P.Lp ? 'Анаморфоза Ленгмюра: отсечка равна 1/A∞, наклон равен 1/(A∞K). Чем ближе точки к прямой, тем лучше применима модель.' : 'Для этих данных прямая Ленгмюра с положительными параметрами не получилась.';
    } else if (a.chart === 'bet') {
      if (!r.bet.applicable) {
        CH.draw(host, { height: 300, series: [] }); note.textContent = 'БЭТ определён для относительного давления: выберите по оси x «p/pₛ» или «p, Па».'; return;
      }
      const sel = pts.filter((p) => p.xpps > 0 && p.xpps < 1);
      const X = sel.map((p) => p.xpps), Y = sel.map((p) => p.xpps / (p.a * (1 - p.xpps)));
      const S_ = [];
      if (P.Bp) {
        const A = P.Bp.f.Ainf, C = P.Bp.f.C, ic = 1 / (A * C), sl = (C - 1) / (A * C), xe = Math.max(r.bet.hi * 1.15, 0.1);
        S_.push({ kind: 'line', x: [0, xe], y: [ic, ic + sl * xe], color: 'c3', name: `Прямая: R² = ${P.Bp.m === 'lin' ? fix(P.Bp.f.r2, 4) : '—'}`, width: 2.4 });
      }
      S_.push({ kind: 'band', x0: r.bet.lo, x1: r.bet.hi, color: 'c3', opacity: 0.1 });
      S_.push({ kind: 'points', x: X, y: Y, color: 'ink', name: 'Эксперимент', r: 4.6, faded: (i) => !sel[i].inBET,
        tip: (i) => `<b>p/pₛ</b> = ${fmt(X[i])}<br>p/[A(1−p/pₛ)] = ${fmt(Y[i])}${sel[i].inBET ? '' : '<br><i>вне интервала БЭТ</i>'}` });
      CH.draw(host, { height: 300, xlabel: 'p/pₛ', ylabel: 'p/pₛ / [A(1 − p/pₛ)], кг/моль', xzero: true, yzero: true, series: S_ });
      note.textContent = `Закрашенные точки лежат в интервале ${fix(r.bet.lo, 2)}–${fix(r.bet.hi, 2)} и участвуют в расчёте, пустые остаются вне его. Отсечка i = 1/(A∞C), наклон s = (C−1)/(A∞C).`;
    } else {
      const X = xs.map(Math.log), Y = as.map(Math.log), S_ = [];
      if (P.Fp) {
        const x0 = Math.min(...X), x1 = Math.max(...X), pd = (x1 - x0) * 0.06, lk = Math.log(P.Fp.f.KF);
        S_.push({ kind: 'line', x: [x0 - pd, x1 + pd], y: [lk + P.Fp.f.invN * (x0 - pd), lk + P.Fp.f.invN * (x1 + pd)], color: 'c2', name: `Прямая: R² = ${P.Fp.m === 'lin' ? fix(P.Fp.f.r2, 4) : '—'}`, width: 2.4 });
      }
      S_.push({ kind: 'points', x: X, y: Y, color: 'ink', name: 'Эксперимент', r: 4.6, tip: (i) => `<b>${L[2]}</b> = ${fmt(X[i])}<br>ln A = ${fmt(Y[i])}` });
      CH.draw(host, { height: 300, xlabel: L[2], ylabel: 'ln A', series: S_ });
      note.textContent = 'Анаморфоза Фрейндлиха: наклон равен 1/n, отсечка равна ln K_F.';
    }
  }

  function adsCopy() {
    if (!adsRes || !adsRes.ok) return;
    const t = $('#ads-rt'); const rows = $$('tr', t).map((tr) => $$('th,td', tr).map((c) => c.textContent.replace(/\s+/g, ' ').trim()));
