            <div class="fld"><span class="lb">Масса m</span>
              <div class="seg" id="sed-mu" role="radiogroup" aria-label="Единицы массы"><button type="button" role="radio" data-v="mg">мг</button><button type="button" role="radio" data-v="g">г</button></div></div>
          </div>
