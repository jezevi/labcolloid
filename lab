        <article class="card">
          <h3>Параметры системы</h3>
          <div class="fields">
            <label class="fld"><span class="lb">h, м (высота столба)</span><input id="sed-h" inputmode="decimal" autocomplete="off"></label>
            <label class="fld"><span class="lb">ρ, кг/м³ (частицы)</span><input id="sed-rho" inputmode="decimal" autocomplete="off"></label>
            <label class="fld"><span class="lb">ρ₀, кг/м³ (среда)</span><input id="sed-rho0" inputmode="decimal" autocomplete="off"></label>
            <label class="fld"><span class="lb">η, Па·с</span><input id="sed-eta" inputmode="decimal" autocomplete="off"></label>
            <label class="fld"><span class="lb">g, м/с²</span><input id="sed-g" inputmode="decimal" autocomplete="off"></label>
            <label class="fld"><span class="lb">m₀, масса пустой чашечки</span><input id="sed-m0" inputmode="decimal" autocomplete="off"></label>
