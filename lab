  /* ==========================================================
     МОДУЛЬ 2. СЕДИМЕНТАЦИЯ
     ========================================================== */
  let sedRes = null;
  function sedInput() {
    const s = S.sed;
    return { tauUnit: s.tauUnit, h: s.h, rho: s.rho, rho0: s.rho0, eta: s.eta, g: s.g, m0: s.m0, minf: s.minf, smooth: s.smooth, axis: s.axis, addOrigin: s.origin,
      rows: s.rows.map((q) => ({ t: q.t, m: q.m })) };
  }
  const tauAt = (r, pos) => r.tMin * Math.pow(r.tMax / r.tMin, pos / 1000);
  const tauStr = (tau, r) => `${fmt(tau / r.tf, 3)} ${r.tf === 60 ? 'мин' : 'с'}`;

  function renderSed() {
    const s = S.sed;
    const r = LC.sedimentation(sedInput());
    sedRes = r;
    if (!r.ok) {
      $('#sed-msgs').innerHTML = msgHTML(r.errors, r.warnings);
      ['#sed-kpis', '#sed-ty'].forEach((q) => { $(q).innerHTML = ''; });
      $('#sed-rt').innerHTML = ''; $('#sed-ty-head').hidden = true; $('#sed-tab-det').hidden = true; $('#sed-tangent-ctl').hidden = true;
      CH.draw($('#sed-chart'), { height: 280, series: [] }); $('#sed-chart-note').textContent = 'Введите параметры системы и кривую седиментации.';
      return;
    }
    $('#sed-ty-head').hidden = false; $('#sed-tab-det').hidden = false;
    $('#sed-msgs').innerHTML = msgHTML([], r.warnings);
    const ty = r.tsyurupa, mu = s.massUnit === 'g' ? 'г' : 'мг';

    let k = '';
    k += kpi('Модальный радиус r<sub>мод</sub>', fmt(r.mode.r, 3), 'мкм', `максимум F = ${fmt(r.mode.F, 3)} %/мкм`, true);
    k += kpi('Медианный радиус r₅₀', fmt(r.r50, 3), 'мкм', 'половина частиц крупнее');
    k += kpi('r₉₀ … r₁₀', `${fmt(r.r90, 3)} … ${fmt(r.r10, 3)}`, 'мкм', isNum(r.width) ? `r₁₀/r₉₀ = ${fmt(r.width, 3)}` : 'r₁₀ вне окна измерений', false, 'rng');
    k += kpi('Число Рейнольдса', fmt(r.Re, 2), '', r.Re > 0.2 ? 'выше 0,2: закон Стокса неточен' : 'ламинарное оседание, Re < 0,2');
    $('#sed-kpis').innerHTML = k;

    let t = '';
    if (ty.ok) {
      t += kpi('Q<sub>m</sub>', fmt(ty.Qm, 4), '%', 'масса при τ → ∞');
      t += kpi('τ₀', fmt(ty.tau0 / r.tf, 4), r.tf === 60 ? 'мин' : 'с', 'половинное время');
      t += kpi('r<sub>н</sub> = r₀/√5', fmt(ty.rn, 3), 'мкм', `r₀ = ${fmt(ty.r0, 3)} мкм`, true);
      t += kpi('r<sub>min</sub> … r<sub>max</sub>', `${isNum(ty.rmin) ? fmt(ty.rmin, 3) : '—'} … ${fmt(ty.rmax, 3)}`, 'мкм', isNum(ty.SP) ? `СП = ${fmt(ty.SP, 3)}` : 'r<sub>min</sub> не определён при Q<sub>m</sub> ≤ 100', false, 'rng');
      t += kpi('R² прямой τ/Q', fix(ty.r2, 4), '', 'линейность по Цюрупе');
      const ag = r.modeAgree;
      t += kpi('Сходимость методов', `${fix(ag * 100, 0)}`, '%', ag > 0.25 ? 'r<sub>мод</sub> расходится с r<sub>н</sub>' : 'r<sub>мод</sub> близок к r<sub>н</sub>');
    } else t = `<div class="msg info" style="grid-column:1/-1">${ty.reason}</div>`;
    $('#sed-ty').innerHTML = t;

    // таблица 2.4
    let h = `<thead><tr><th>τ, ${r.tf === 60 ? 'мин' : 'с'}</th><th>r, мкм</th><th>Q, %</th><th>Δr</th><th>ΔQ</th><th>F, %/мкм</th></tr></thead><tbody>`;
    r.table.forEach((q) => {
      h += `<tr><td>${fmt(q.tau / r.tf, 3)}</td><td>${fmt(q.r, 3)}</td><td class="${q.Q < 0 ? 'neg' : ''}">${fmt(q.Q, 3)}</td><td>${fmt(q.dr, 3)}</td><td>${fmt(q.dQ, 3)}</td><td>${fmt(q.F, 3)}</td></tr>`;
    });
    h += '</tbody>';
    $('#sed-rt').innerHTML = h;

    // ползунок касательной
    $('#sed-tangent-ctl').hidden = S.sed.chart !== 'curve';
    const tau = tauAt(r, s.tauPos), tg = r.tangentAt(tau);
    $('#sed-tau-o').innerHTML = `τ* = <b>${tauStr(tau, r)}</b> · r = <b>${fmt(tg.r, 3)} мкм</b> · Q = <b>${fix(tg.Q, 1)} %</b>`;
    drawSed(r, tg, mu);
  }

  function drawSed(r, tg, mu) {
    const s = S.sed, host = $('#sed-chart'), note = $('#sed-chart-note'), tf = r.tf, g = r.grid;
    const tu = tf === 60 ? 'мин' : 'с';
    if (s.chart === 'curve') {
      const xe = (r.tMax / tf) * 1.04, mm = r.mmax;
      const S_ = [];
      S_.push({ kind: 'hline', y: mm, color: 'c5', dash: '5 4', label: 'm_max' });
      if (s.allTan) r.points.forEach((p) => {
        const q = r.tangentAt(p.tau), x1 = Math.min(xe, (p.tau / tf) * 2);
        S_.push({ kind: 'ref', x: [0, x1], y: [q.intercept, q.intercept + q.slope * tf * x1], color: 'c5', width: 1.2, opacity: 0.75 });
      });
      S_.push({ kind: 'line', x: g.tau.map((t) => t / tf), y: g.m, color: 'c1', name: 'Сглаживающий сплайн', width: 2.4 });
      const x1 = xe;
      S_.push({ kind: 'ref', x: [0, x1], y: [tg.intercept, tg.intercept + tg.slope * tf * x1], color: 'c2', name: 'Касательная в τ*', width: 2.2 });
      S_.push({ kind: 'points', x: r.data.map((d) => d.tau / tf), y: r.data.map((d) => d.m), color: 'ink', name: 'Эксперимент', r: 4.4,
        tip: (i) => `<b>τ</b> = ${fmt(r.data[i].tau / tf, 4)} ${tu}<br>m = ${fmt(r.data[i].m, 4)} ${mu}` });
      S_.push({ kind: 'points', x: [tg.tau / tf], y: [tg.m], color: 'c2', r: 5.6, tip: () => `<b>τ*</b> = ${fmt(tg.tau / tf, 4)} ${tu}<br>m = ${fmt(tg.m, 4)} ${mu}<br>r = ${fmt(tg.r, 3)} мкм` });
      S_.push({ kind: 'points', x: [0], y: [tg.intercept], color: 'c2', hollow: true, r: 5.2, tip: () => `Отсечка = ${fmt(tg.intercept, 4)} ${mu}<br>Q = ${fix(tg.Q, 1)} %` });
      S_.push({ kind: 'label', x: 0, y: tg.intercept, text: `Q = ${fix(tg.Q, 1)} %`, color: 'c2', dx: 10, dy: -9 });
      CH.draw(host, { height: 320, xlabel: `τ, ${tu}`, ylabel: `m, ${mu}`, xlim: [0, xe], ylim: [0, mm * 1.12], series: S_ });
      note.textContent = 'Касательная в точке τ* отсекает на оси m отрезок, равный массе уже осевших частиц крупнее r(τ*). Отсечка, делённая на m_max, даёт долю Q.';
    } else if (s.chart === 'int') {
      const ty = r.tsyurupa, rmaxPlot = Math.max(...r.points.map((p) => p.r)) * 1.05;
      const S_ = [];
      S_.push({ kind: 'hline', y: 50, color: 'c5', dash: '5 4', label: '50 %' });
      S_.push({ kind: 'line', x: g.r, y: g.Q, color: 'c1', name: 'По сплайну', width: 2.4 });
      if (ty.ok) { const rr = [], N = 120; for (let i = 0; i <= N; i++) rr.push((rmaxPlot * i) / N); S_.push({ kind: 'ref', x: rr, y: rr.map(ty.Qfn), color: 'c3', dash: '6 4', name: 'Метод Цюрупы', width: 2.2 }); }
      S_.push({ kind: 'points', x: r.points.map((p) => p.r), y: r.points.map((p) => p.Q), color: 'ink', name: 'Точки касательных', r: 4, faded: (i) => r.points[i].Q < 0,
        tip: (i) => `<b>r</b> = ${fmt(r.points[i].r, 3)} мкм<br>Q = ${fmt(r.points[i].Q, 3)} %` });
      const qmin = Math.min(0, ...r.points.map((p) => p.Q));
      CH.draw(host, { height: 320, xlabel: 'r, мкм', ylabel: 'Q, % (частицы крупнее r)', xlim: [0, rmaxPlot], ylim: [qmin - 4, 108], series: S_ });
      note.textContent = 'Q(r) — доля частиц с радиусом больше r. Пустые точки с Q < 0 — погрешность сплайна на краю, физически Q ≥ 0.';
    } else {
      const ty = r.tsyurupa, rmaxPlot = Math.max(...r.points.map((p) => p.r)) * 1.05;
      const S_ = [];
      S_.push({ kind: 'line', x: g.r, y: g.F, color: 'c1', name: 'По сплайну', width: 2.4, tip: (i) => `<b>r</b> = ${fmt(g.r[i], 3)} мкм<br>F = ${fmt(g.F[i], 3)} %/мкм`, tipEvery: 4 });
      if (ty.ok) { const rr = [], N = 160; for (let i = 1; i <= N; i++) rr.push((rmaxPlot * i) / N); S_.push({ kind: 'ref', x: rr, y: rr.map(ty.Ffn), color: 'c3', dash: '6 4', name: 'Метод Цюрупы', width: 2.2 }); }
      const tp = r.table.filter((q) => isNum(q.F));
      S_.push({ kind: 'points', x: tp.map((q) => q.rcp), y: tp.map((q) => q.F), color: 'ink', name: 'Табл. 2.4 (ΔQ/Δr)', r: 3.8, tip: (i) => `<b>r</b> ≈ ${fmt(tp[i].rcp, 3)} мкм<br>ΔQ/Δr = ${fmt(tp[i].F, 3)} %/мкм` });
      S_.push({ kind: 'vline', x: r.mode.r, color: 'c2', dash: '5 4', label: `r_мод = ${fmt(r.mode.r, 3)} мкм` });
      const fmax = Math.max(...g.F, ...tp.map((q) => q.F));
      CH.draw(host, { height: 320, xlabel: 'r, мкм', ylabel: 'F = −dQ/dr, %/мкм', xlim: [0, rmaxPlot], ylim: [0, fmax * 1.15], series: S_ });
      note.textContent = 'Максимум дифференциальной кривой даёт наиболее вероятный радиус. Вторая производная шумных данных ненадёжна, поэтому рядом показан метод Цюрупы.';
    }
  }

  function sedCopy() {
    if (!sedRes || !sedRes.ok) return;
    const r = sedRes, ty = r.tsyurupa, rows = [];
    rows.push(['Модальный радиус, мкм', fmt(r.mode.r, 4)], ['r50, мкм', fmt(r.r50, 4)], ['r10, мкм', fmt(r.r10, 4)], ['r90, мкм', fmt(r.r90, 4)], ['Re', fmt(r.Re, 3)]);
    if (ty.ok) rows.push(['Цюрупа: Qm, %', fmt(ty.Qm, 4)], ['Цюрупа: tau0, с', fmt(ty.tau0, 4)], ['Цюрупа: r0, мкм', fmt(ty.r0, 4)], ['Цюрупа: r_н, мкм', fmt(ty.rn, 4)]);
    rows.push([], ['tau, с', 'r, мкм', 'Q, %', 'F, %/мкм']);
    r.table.forEach((q) => rows.push([fmt(q.tau, 4), fmt(q.r, 4), fmt(q.Q, 4), fmt(q.F, 4)]));
    copyText(tsv(rows));
  }

  /* ==========================================================
     МОДУЛЬ 3. ζ-ПОТЕНЦИАЛ
     ========================================================== */
  let zRes = null;
  function zetaCalc() {
    const z = S.zeta;
    if (z.method === 'ep') {
      return LC.electrophoresis({ input: z.epin, a: z.a, af: 1e-3, tau: z.tau, tf: 60, U: z.U, L: z.L, u: z.u, uf: 1e-6, E: z.E,
        eps: z.eps, eta: z.eta, dir: z.dir, corr: z.corr, T: z.T, I: z.ion, rad: z.rad });
    }
    return LC.electroosmosis({ eoForm: z.eoform, vMode: z.vmode === 'rate' ? 'flow' : 'volume', V: z.V, Vf: 1e-6, tau: z.eotau, v: z.v, vf: 1e-6, I: z.I, If: 1e-3,
      kappa: z.kappa, surf: z.surf, R1: z.R1, R2: z.R2, kst: z.kst, u: z.eou, uf: 1e-6, E: z.eoE, eps: z.eps, eta: z.eta, dir: z.dir });
  }
  function gauge(zmv, st) {
    const lim = 80, pos = (v) => ((Math.max(-lim, Math.min(lim, v)) + lim) / (2 * lim)) * 100;
    const ticks = [-60, -30, 0, 30, 60].map((v) => `<span class="g-tick" style="left:${pos(v)}%">${String(v).replace('-', '−')}</span>`).join('');
    return `<div class="gauge" role="img" aria-label="Шкала ζ-потенциала от −80 до +80 мВ, значение ${fix(zmv, 1)} мВ">` +
      `<div class="g-bar"><div class="g-zone" style="left:0;width:${pos(-30)}%"></div><div class="g-zone" style="left:${pos(30)}%;right:0"></div></div>` +
      `<div class="g-zero" style="left:${pos(0)}%"></div>${ticks}<div class="g-mark" style="left:${pos(zmv)}%"></div>` +
      `<div class="g-val" style="left:${Math.max(10, Math.min(90, pos(zmv)))}%">${sgn(zmv)} мВ</div></div>`;
  }
  const fmtE = (v) => fmt(v, 3);

  function renderZeta() {
    const z = S.zeta, r = zCalcSafe();
    zRes = r;
    if (!r.ok) {
      $('#zeta-msgs').innerHTML = msgHTML(r.errors, r.warnings);
      $('#zeta-out').innerHTML = '<p class="hint">Заполните данные слева, и здесь появится ζ-потенциал.</p>';
      renderSeries(); return;
    }
    $('#zeta-msgs').innerHTML = msgHTML([], r.warnings);
    const zm = r.zetaMV, st = r.stability;
    const chargeTxt = r.method === 'electrophoresis'
      ? (r.sgn > 0 ? 'Граница ушла к катоду: частицы заряжены положительно.' : 'Граница ушла к аноду: частицы заряжены отрицательно.')
      : (r.sgn < 0 ? 'Жидкость течёт к катоду: поверхность заряжена отрицательно.' : 'Жидкость течёт к аноду: поверхность заряжена положительно.');
    let kv = '';
    if (r.method === 'electrophoresis') {
      kv += `<dt>Скорость границы u</dt><dd>${fmtE(r.u * 1e6)} мкм/с</dd>`;
      kv += `<dt>Напряжённость поля E</dt><dd>${fmtE(r.E)} В/м</dd>`;
      kv += `<dt>Подвижность U<sub>эф</sub></dt><dd>${fmtE(r.Ue * 1e8)}·10⁻⁸ м²/(В·с)</dd>`;
      kv += `<dt>Поправка</dt><dd>${esc(dec(r.kText))}</dd>`;
      if (isNum(r.lambda)) kv += `<dt>Толщина слоя λ</dt><dd>${fmtE(r.lambda * 1e9)} нм</dd>`;
      if (isNum(r.ka)) kv += `<dt>κa</dt><dd>${fmtE(r.ka)}</dd>`;
    } else {
      const i = r.info;
      if (i.v != null) kv += `<dt>Объёмная скорость v</dt><dd>${fmtE(i.v * 1e6)} мл/с</dd><dt>Сила тока I</dt><dd>${fmtE(i.I * 1e3)} мА</dd><dt>${i.kappaEff != null ? 'κ с поправкой на поверхностную проводимость' : 'Проводимость κ'}</dt><dd>${fmtE(i.kappa)} См/м</dd>`;
      if (i.u != null) kv += `<dt>Скорость u</dt><dd>${fmtE(i.u * 1e6)} мкм/с</dd><dt>Напряжённость E</dt><dd>${fmtE(i.E)} В/м</dd>`;
    }
    $('#zeta-out').innerHTML =
      `<div class="zhead"><div class="zbig">${sgn(zm)}<span class="u">мВ</span></div><div class="zsign">${chargeTxt}</div></div>` +
      gauge(zm, st) +
      `<div class="verdict"><span class="chip ${st.level}">${st.label}</span><p class="hint">${st.text} Шкала ±30 мВ — практическое правило, в учебнике её нет; для стерической и полимерной стабилизации оно не работает.</p></div>` +
      `<dl class="kv">${kv}</dl>`;
    renderSeries();
  }
  function zCalcSafe() { try { return zetaCalc(); } catch (e) { return { ok: false, errors: ['Не удалось рассчитать: ' + e.message], warnings: [] }; } }

  function renderSeries() {
    const z = S.zeta, ser = z.series, host = $('#zeta-chart');
    if (!ser.length) { $('#zeta-st').innerHTML = ''; host.hidden = true; return; }
    let h = '<thead><tr><th>Образец</th><th>c, ммоль/л</th><th>ζ, мВ</th><th></th></tr></thead><tbody>';
    ser.forEach((p, i) => { h += `<tr><td>${esc(p.label || '—')}</td><td>${isNum(p.c) ? fmt(p.c, 4) : '—'}</td><td>${sgn(p.z)}</td><td><button type="button" class="del" data-sdel="${i}" aria-label="Удалить">×</button></td></tr>`; });
    $('#zeta-st').innerHTML = h + '</tbody>';
    const withC = ser.filter((p) => isNum(p.c)).sort((a, b) => a.c - b.c);
    host.hidden = withC.length === 0;
    if (!withC.length) return;
    const S_ = [{ kind: 'hline', y: 30, color: 'c5', dash: '5 4', label: '+30 мВ' }, { kind: 'hline', y: -30, color: 'c5', dash: '5 4', label: '−30 мВ' }];
    if (withC.length > 1) S_.push({ kind: 'line', x: withC.map((p) => p.c), y: withC.map((p) => p.z), color: 'c1', width: 2.2 });
    S_.push({ kind: 'points', x: withC.map((p) => p.c), y: withC.map((p) => p.z), color: 'c1', r: 5, name: 'ζ(c)', tip: (i) => `<b>${esc(withC[i].label || 'образец')}</b><br>c = ${fmt(withC[i].c, 4)} ммоль/л<br>ζ = ${sgn(withC[i].z)} мВ` });
    CH.draw(host, { height: 280, xlabel: 'c электролита, ммоль/л', ylabel: 'ζ, мВ', series: S_ });
  }

  /* ---------- вкладки ---------- */
  function showTab(t, fromHash) {
    if (!['ads', 'sed', 'zeta'].includes(t)) t = 'ads';
    S.tab = t;
    $$('#nav button').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === t)));
    ['ads', 'sed', 'zeta'].forEach((m) => { $('#mod-' + m).hidden = m !== t; });
    if (!fromHash) { try { history.replaceState(null, '', '#' + t); } catch (e) { /* ничего */ } }
    window.scrollTo(0, 0); save();
    ({ ads: renderAds, sed: renderSed, zeta: renderZeta })[t]();
  }

  /* ---------- запуск ---------- */
  function init() {
    load();
    if (!restored) { loadAdsDemo('ex7'); loadSedDemo('p6v2'); loadZetaDemo('ep2'); }

    // списки демо-данных
    $('#ads-demo').innerHTML = Object.keys(ADS_DEMOS).map((k) => `<option value="${k}">${esc(ADS_DEMOS[k].name)}</option>`).join('');
    $('#sed-demo').innerHTML = Object.keys(SED_DEMOS).map((k) => `<option value="${k}">${esc(SED_DEMOS[k].name)}</option>`).join('');
    $('#zeta-demo').innerHTML = Object.keys(ZETA_DEMOS).map((k) => `<option value="${k}">${esc(ZETA_DEMOS[k].name)}</option>`).join('');

    const adsT = makeTable('ads-table', 'ads', ['x', 'a'], ['x', 'A'], () => schedule('ads'));
    const sedT = makeTable('sed-table', 'sed', ['t', 'm'], ['τ', 'm'], () => schedule('sed'));
    wireImport('ads', adsT, ['x', 'a']); wireImport('sed', sedT, ['t', 'm']);

    // текстовые поля
    Object.keys(inputs).forEach((m) => inputs[m].forEach((k) => {
      const el = $(`#${m}-${k}`); if (!el) return;
      el.addEventListener('input', () => { S[m][k] = el.value; schedule(m); });
    }));
    // переключатели
    segs.forEach(([id, m, k]) => {
      $('#' + id).addEventListener('click', (e) => {
        const b = e.target.closest('button'); if (!b) return;
        S[m][k] = b.dataset.v;
        if (id === 'ads-xtype') { fillUnitSelects(); }
        syncControls(); schedule(m);
      });
    });
    checks.forEach(([id, m, k]) => $('#' + id).addEventListener('change', (e) => { S[m][k] = e.target.checked; layout(); schedule(m); }));
    $('#ads-xunit').addEventListener('change', (e) => { S.ads.xUnit = e.target.value; layout(); schedule('ads'); });
    $('#ads-aunit').addEventListener('change', (e) => { S.ads.aUnit = e.target.value; layout(); schedule('ads'); });
    $('#zeta-dir').addEventListener('change', (e) => { S.zeta.dir = e.target.value; schedule('zeta'); });
    $('#sed-smooth').addEventListener('input', (e) => { S.sed.smooth = Number(e.target.value); layout(); schedule('sed'); });
    $('#sed-tau').addEventListener('input', (e) => { S.sed.tauPos = Number(e.target.value); schedule('sed'); });

    // демо-данные
    $('#ads-demo').addEventListener('change', (e) => { S.ads.demo = e.target.value; layout(); save(); });
    $('#sed-demo').addEventListener('change', (e) => { S.sed.demo = e.target.value; layout(); save(); });
    $('#zeta-demo').addEventListener('change', (e) => { S.zeta.demo = e.target.value; layout(); save(); });
    $('#ads-load').addEventListener('click', () => { loadAdsDemo($('#ads-demo').value); adsT.render(); syncControls(); schedule('ads'); toast('Загружен пример'); });
    $('#sed-load').addEventListener('click', () => { loadSedDemo($('#sed-demo').value); sedT.render(); syncControls(); schedule('sed'); toast('Загружен пример'); });
    $('#zeta-load').addEventListener('click', () => { loadZetaDemo($('#zeta-demo').value); syncControls(); schedule('zeta'); toast('Загружен пример'); });

    // кнопки таблиц
    $('#ads-add').addEventListener('click', () => adsT.add()); $('#ads-clear').addEventListener('click', () => adsT.clear());
    $('#sed-add').addEventListener('click', () => sedT.add()); $('#sed-clear').addEventListener('click', () => sedT.clear());
    $('#ads-copy').addEventListener('click', adsCopy); $('#sed-copy').addEventListener('click', sedCopy);

    // серия ζ
    $('#zeta-sadd').addEventListener('click', () => {
      const r = zCalcSafe(); if (!r.ok) { toast('Сначала получите корректный результат'); return; }
      const z = S.zeta, c = num(z.sc);
      z.series.push({ label: z.slabel || '', c: isNum(c) ? c : null, z: r.zetaMV });
      z.slabel = ''; z.sc = ''; syncControls(); renderSeries(); save(); toast('Добавлено в серию');
    });
    $('#zeta-sclear').addEventListener('click', () => { S.zeta.series = []; renderSeries(); save(); });
    $('#zeta-st').addEventListener('click', (e) => { const b = e.target.closest('[data-sdel]'); if (!b) return; S.zeta.series.splice(+b.dataset.sdel, 1); renderSeries(); save(); });

    // сброс всех данных (двойное нажатие вместо confirm)
    let armed = 0;
    $('#reset-all').addEventListener('click', (e) => {
      const b = e.currentTarget;
      if (!armed) { b.textContent = 'Нажмите ещё раз, чтобы сбросить'; armed = setTimeout(() => { armed = 0; b.textContent = 'Сбросить все данные и вернуть примеры'; }, 4000); return; }
      clearTimeout(armed); armed = 0; b.textContent = 'Сбросить все данные и вернуть примеры';
      try { localStorage.removeItem(KEY); } catch (er) { /* ничего */ }
      S = defaults(); loadAdsDemo('ex7'); loadSedDemo('p6v2'); loadZetaDemo('ep2');
      adsT.render(); sedT.render(); syncControls(); showTab('ads'); toast('Данные сброшены');
    });

    // навигация
    $('#nav').addEventListener('click', (e) => { const b = e.target.closest('button'); if (b) showTab(b.dataset.tab); });
    window.addEventListener('hashchange', () => { const t = location.hash.replace('#', ''); if (['ads', 'sed', 'zeta'].includes(t) && t !== S.tab) showTab(t, true); });

    adsT.render(); sedT.render(); syncControls();
    const h = (location.hash || '').replace('#', '');
    showTab(['ads', 'sed', 'zeta'].includes(h) ? h : S.tab, true);

    // подсказка по установке (только в PWA-сборке на iPhone в браузере)
    if (window.LC_PWA) {
      const standalone = window.navigator.standalone === true || (window.matchMedia && matchMedia('(display-mode: standalone)').matches);
      if (!standalone && /iPhone|iPad|iPod/.test(navigator.userAgent)) {
        const p = document.createElement('p');
        p.innerHTML = '<b>Установка на iPhone.</b> В Safari нажмите «Поделиться» и выберите «На экран “Домой”». Дальше приложение работает без интернета.';
        $('.foot').insertBefore(p, $('.foot').firstChild);
      }
      if ('serviceWorker' in navigator && /^https?:$/.test(location.protocol)) navigator.serviceWorker.register('sw.js').catch(() => { /* офлайн-режим недоступен */ });
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();

</script>
