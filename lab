            <div class="seg" id="zeta-corr" role="radiogroup" aria-label="Поправка"><button type="button" role="radio" data-v="smol">Смолуховский</button><button type="button" role="radio" data-v="huckel">Хюккель</button><button type="button" role="radio" data-v="henry">Генри</button></div></div>
          <div class="fields" id="zeta-ka-f">
            <label class="fld"><span class="lb">T, К</span><input id="zeta-T" inputmode="decimal" autocomplete="off"></label>
            <label class="fld"><span class="lb">Ионная сила I, моль/л</span><input id="zeta-ion" inputmode="decimal" autocomplete="off" placeholder="необязательно"></label>
            <label class="fld"><span class="lb">Радиус частицы, нм</span><input id="zeta-rad" inputmode="decimal" autocomplete="off" placeholder="необязательно"></label>
